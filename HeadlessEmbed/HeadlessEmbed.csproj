<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HeadlessEmbed</AssemblyName>
    <RootNamespace>HeadlessEmbed</RootNamespace>
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8602;CS8604</NoWarn>
  </PropertyGroup>

  <!--
    Runs SCPBrowser's own embedding pipeline outside the GUI so a figure can be generated reproducibly and checked
    against the application. It calls the real methods on ScatterPlotControl by reflection rather than reimplementing
    them: any divergence between this harness and what the user sees on screen would defeat the purpose. Nothing
    here touches classification. The UMAP engines, including the native uwot.dll, come through the SCPBrowser
    reference.
  -->
  <ItemGroup>
    <ProjectReference Include="..\SCPBrowser\SCPBrowser.csproj" />
  </ItemGroup>

</Project>
