<UserControl x:Class="SCPBrowser.Controls.CellPlateViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#f8fafc">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0">
        <DockPanel Margin="0,0,0,4" LastChildFill="False">
            <TextBlock Text="Run:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
            <ComboBox x:Name="RunCombo" Width="360" Height="26" VerticalContentAlignment="Center"
                      SelectionChanged="RunCombo_SelectionChanged"/>
            <Button x:Name="ReconcileButton" Content="Reconcile ↔ runs..." Margin="12,0,0,0" Padding="10,4"
                    Click="ReconcileButton_Click"
                    ToolTip="Match these cells to DIA-NN raw files"/>
            <Button x:Name="ReanalyzeButton" Content="↻ Reanalyze" Margin="6,0,0,0" Padding="10,4"
                    Click="ReanalyzeButton_Click"
                    ToolTip="Reset this run's automatic doublet flags and re-run image-based doublet detection (your keep/discard decisions are kept)"/>
            <TextBlock Text="Size:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="16,0,4,0"/>
            <Slider x:Name="ZoomSlider" Width="120" Minimum="0.4" Maximum="3.0" Value="1.0" SmallChange="0.1" LargeChange="0.5"
                    VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged" ToolTip="Cell image size (the grid also rescales as you resize the window)"/>
            <TextBlock Text="Show:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="16,0,4,0"/>
            <ComboBox x:Name="ReviewFilterCombo" Width="120" Height="26" VerticalContentAlignment="Center"
                      SelectionChanged="ReviewFilterCombo_SelectionChanged"
                      ToolTip="Filter the grid to cells in a given review state">
                <ComboBoxItem Content="All" IsSelected="True"/>
                <ComboBoxItem Content="Needs review"/>
                <ComboBoxItem Content="Kept"/>
                <ComboBoxItem Content="Discarded"/>
            </ComboBox>
            <TextBlock x:Name="ReviewCountText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#92400e" FontWeight="SemiBold"/>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#64748b"/>
        </DockPanel>

        <!-- Ejection / sedimentation zone boundaries (run-level, camera px): display, edit, save, filter, draw. -->
        <DockPanel Margin="0,0,0,8" LastChildFill="False">
            <CheckBox x:Name="ShowZonesCheck" Content="Show zones" VerticalAlignment="Center" Foreground="#334155"
                      Checked="ZoneDisplay_Changed" Unchecked="ZoneDisplay_Changed"
                      ToolTip="Draw the ejection (red) and sedimentation (green) boundary lines on the cell image"/>
            <TextBlock Text="Ejection:" VerticalAlignment="Center" Margin="16,0,4,0" Foreground="#334155" FontWeight="SemiBold"/>
            <xctk:IntegerUpDown x:Name="EjBoundBox" Width="66" Minimum="0" Maximum="100000" VerticalAlignment="Center"/>
            <TextBlock Text="Sedimentation:" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="#334155" FontWeight="SemiBold"/>
            <xctk:IntegerUpDown x:Name="SedBoundBox" Width="66" Minimum="0" Maximum="100000" VerticalAlignment="Center"/>
            <TextBlock Text="px" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#94a3b8"/>
            <Button x:Name="SaveBoundsButton" Content="Save zones" Margin="10,0,0,0" Padding="10,2" Click="SaveBounds_Click"
                    ToolTip="Save these boundaries to the database for this run (initially parsed from the logfile)"/>
            <CheckBox x:Name="WithinBoundsCheck" Content="Only cells within bounds" VerticalAlignment="Center" Margin="18,0,0,0"
                      Foreground="#334155" Checked="ZoneFilter_Changed" Unchecked="ZoneFilter_Changed"
                      ToolTip="Filter the grid to cells whose detected X position lies between the sedimentation and ejection boundaries"/>
        </DockPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="0.55*" MinWidth="330"/>
            </Grid.ColumnDefinitions>

            <!-- Left: position grid (top) + gating scatter (bottom) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="230"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Background="White">
                    <ScrollViewer x:Name="GridScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="6">
                        <Canvas x:Name="GridCanvas" Background="White"/>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#e2e8f0"/>

                <Border Grid.Row="2" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="6,4,6,2" LastChildFill="False">
                            <TextBlock Text="X:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,4,0"/>
                            <ComboBox x:Name="XAxisCombo" Width="130" Height="24" VerticalContentAlignment="Center" SelectionChanged="Axis_Changed"/>
                            <TextBlock Text="Y:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="14,0,4,0"/>
                            <ComboBox x:Name="YAxisCombo" Width="130" Height="24" VerticalContentAlignment="Center" SelectionChanged="Axis_Changed"/>
                            <TextBlock Text="click a point to select its cell" VerticalAlignment="Center" Foreground="#94a3b8" FontSize="10" FontStyle="Italic" Margin="14,0,0,0"/>
                        </DockPanel>
                        <scottPlot:WpfPlot Grid.Row="1" x:Name="GatingChart"/>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#e2e8f0"/>

            <!-- Right: cell detail -->
            <Border Grid.Column="2" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Background="White" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Cell detail" FontWeight="Bold" FontSize="14" Foreground="#0f172a" Margin="0,0,0,8"/>
                        <TextBlock x:Name="DetailHint" Text="Click a cell in the grid, or a point in the scatter below."
                                   Foreground="#94a3b8" FontStyle="Italic" TextWrapping="Wrap"/>

                        <TextBlock Text="Brightfield (Trans)" FontWeight="SemiBold" Foreground="#334155" Margin="0,8,0,2"/>
                        <Border BorderBrush="#e2e8f0" BorderThickness="1" Background="#0b1220" MinHeight="70">
                            <Image x:Name="TransImage" Stretch="Uniform" MaxHeight="340"/>
                        </Border>

                        <TextBlock Text="Fluorescence (Blue)" FontWeight="SemiBold" Foreground="#334155" Margin="0,10,0,2"/>
                        <Border BorderBrush="#e2e8f0" BorderThickness="1" Background="#0b1220" MinHeight="70">
                            <Image x:Name="BlueImage" Stretch="Uniform" MaxHeight="340"/>
                        </Border>

                        <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="4" Margin="0,10,0,0" Padding="8">
                            <TextBlock x:Name="DetailText" FontFamily="Consolas" FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                        </Border>

                        <!-- CellProfiler-style phenotype features (computed by CellPhenotypeService on Reanalyze/import). -->
                        <Expander Header="Phenotype (image features)" Margin="0,10,0,0" Foreground="#334155" FontWeight="SemiBold">
                            <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="240">
                                    <TextBlock x:Name="PhenotypeText" FontFamily="Consolas" FontSize="11" Foreground="#334155"/>
                                </ScrollViewer>
                            </Border>
                        </Expander>

                        <!-- Quality review: flag / keep / discard disposition for the selected cell (recorded only, non-destructive). -->
                        <Border x:Name="ReviewPanel" Visibility="Collapsed" Background="#fffbeb" BorderBrush="#fde68a" BorderThickness="1" CornerRadius="4" Margin="0,10,0,0" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Quality review" FontWeight="SemiBold" Foreground="#92400e"/>
                                <TextBlock x:Name="ReviewStateText" Margin="0,2,0,6" TextWrapping="Wrap" Foreground="#334155" FontFamily="Consolas" FontSize="12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="FlagBtn" Content="⚑ Flag" Click="FlagBtn_Click" Padding="9,3" ToolTip="Mark this cell as needing review (F)"/>
                                    <Button x:Name="KeepBtn" Content="✓ Keep" Click="KeepBtn_Click" Padding="9,3" Margin="6,0,0,0"
                                            Background="#16a34a" Foreground="White" BorderThickness="0" ToolTip="Reviewed — keep this cell (K)"/>
                                    <Button x:Name="DiscardBtn" Content="✗ Discard" Click="DiscardBtn_Click" Padding="9,3" Margin="6,0,0,0"
                                            Background="#dc2626" Foreground="White" BorderThickness="0" ToolTip="Reviewed — discard this cell (D)"/>
                                    <Button x:Name="ClearReviewBtn" Content="Clear" Click="ClearReviewBtn_Click" Padding="9,3" Margin="6,0,0,0" ToolTip="Clear the disposition (Backspace)"/>
                                </StackPanel>
                                <TextBlock Text="Note (optional)" Foreground="#64748b" FontSize="10" Margin="0,8,0,2"/>
                                <TextBox x:Name="ReviewNoteBox" Padding="4" TextWrapping="Wrap" AcceptsReturn="True" Height="44"
                                         VerticalScrollBarVisibility="Auto" LostKeyboardFocus="ReviewNoteBox_LostFocus"/>
                                <TextBlock Text="Keys: F flag · K keep · D discard · Backspace clear" Foreground="#94a3b8" FontSize="9" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
