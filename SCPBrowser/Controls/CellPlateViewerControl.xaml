<UserControl x:Class="SCPBrowser.Controls.CellPlateViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#f8fafc">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock Text="Run:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
            <ComboBox x:Name="RunCombo" Width="360" Height="26" VerticalContentAlignment="Center"
                      SelectionChanged="RunCombo_SelectionChanged"/>
            <Button x:Name="ReconcileButton" Content="Reconcile ↔ runs..." Margin="12,0,0,0" Padding="10,4"
                    Click="ReconcileButton_Click"
                    ToolTip="Match these cells to DIA-NN raw files"/>
            <TextBlock Text="Size:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="16,0,4,0"/>
            <Slider x:Name="ZoomSlider" Width="120" Minimum="0.4" Maximum="3.0" Value="1.0" SmallChange="0.1" LargeChange="0.5"
                    VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged" ToolTip="Cell image size (the grid also rescales as you resize the window)"/>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#64748b"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="0.55*" MinWidth="330"/>
            </Grid.ColumnDefinitions>

            <!-- Left: position grid (top) + gating scatter (bottom) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="230"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Background="White">
                    <ScrollViewer x:Name="GridScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="6">
                        <Canvas x:Name="GridCanvas" Background="White"/>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#e2e8f0"/>

                <Border Grid.Row="2" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="6,4,6,2" LastChildFill="False">
                            <TextBlock Text="X:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,4,0"/>
                            <ComboBox x:Name="XAxisCombo" Width="130" Height="24" VerticalContentAlignment="Center" SelectionChanged="Axis_Changed"/>
                            <TextBlock Text="Y:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="14,0,4,0"/>
                            <ComboBox x:Name="YAxisCombo" Width="130" Height="24" VerticalContentAlignment="Center" SelectionChanged="Axis_Changed"/>
                            <TextBlock Text="click a point to select its cell" VerticalAlignment="Center" Foreground="#94a3b8" FontSize="10" FontStyle="Italic" Margin="14,0,0,0"/>
                        </DockPanel>
                        <scottPlot:WpfPlot Grid.Row="1" x:Name="GatingChart"/>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#e2e8f0"/>

            <!-- Right: cell detail -->
            <Border Grid.Column="2" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Background="White" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Cell detail" FontWeight="Bold" FontSize="14" Foreground="#0f172a" Margin="0,0,0,8"/>
                        <TextBlock x:Name="DetailHint" Text="Click a cell in the grid, or a point in the scatter below."
                                   Foreground="#94a3b8" FontStyle="Italic" TextWrapping="Wrap"/>

                        <TextBlock Text="Brightfield (Trans)" FontWeight="SemiBold" Foreground="#334155" Margin="0,8,0,2"/>
                        <Border BorderBrush="#e2e8f0" BorderThickness="1" Background="#0b1220" MinHeight="70">
                            <Image x:Name="TransImage" Stretch="Uniform" MaxHeight="340"/>
                        </Border>

                        <TextBlock Text="Fluorescence (Blue)" FontWeight="SemiBold" Foreground="#334155" Margin="0,10,0,2"/>
                        <Border BorderBrush="#e2e8f0" BorderThickness="1" Background="#0b1220" MinHeight="70">
                            <Image x:Name="BlueImage" Stretch="Uniform" MaxHeight="340"/>
                        </Border>

                        <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="4" Margin="0,10,0,0" Padding="8">
                            <TextBlock x:Name="DetailText" FontFamily="Consolas" FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
