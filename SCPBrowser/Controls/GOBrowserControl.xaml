<!--
GOBrowserControl.xaml
Child control for browsing GO annotations (Gene Ontology)
Location: SCPBrowser/Controls/GOBrowserControl.xaml
-->
<UserControl x:Class="SCPBrowser.GOBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- GO Summary Panel with Tooltips -->
        <Border Grid.Row="0"
                Background="#f1f5f9"
                Padding="15"
                BorderBrush="#cbd5e1"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Gene Ontology Statistics" 
                           FontSize="15" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Terms -->
                    <Border Grid.Column="0" 
                            Background="White" 
                            CornerRadius="4" 
                            Padding="10" 
                            Margin="0,0,5,0"
                            BorderBrush="#e2e8f0"
                            BorderThickness="1">
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="300">
                                    <Bold>Total GO Terms</Bold>
                                    <LineBreak/>
                                    Total number of Gene Ontology terms in the GO Slim database. GO Slim is a subset of the full GO containing high-level terms useful for annotation.
                                </TextBlock>
                            </ToolTip>
                        </Border.ToolTip>
                        <StackPanel>
                            <TextBlock Text="Total Terms" 
                                       FontSize="11" 
                                       Foreground="#64748b"/>
                            <TextBlock x:Name="TotalTermsText" 
                                       Text="0" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       Foreground="#2563eb"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Proteins -->
                    <Border Grid.Column="1" 
                            Background="White" 
                            CornerRadius="4" 
                            Padding="10" 
                            Margin="0,0,5,0"
                            BorderBrush="#e2e8f0"
                            BorderThickness="1">
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="300">
                                    <Bold>Annotated Proteins</Bold>
                                    <LineBreak/>
                                    Number of unique proteins that have at least one GO annotation in the database.
                                </TextBlock>
                            </ToolTip>
                        </Border.ToolTip>
                        <StackPanel>
                            <TextBlock Text="Annotated Proteins" 
                                       FontSize="11" 
                                       Foreground="#64748b"/>
                            <TextBlock x:Name="TotalProteinsText" 
                                       Text="0" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       Foreground="#10b981"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Annotations -->
                    <Border Grid.Column="2" 
                            Background="White" 
                            CornerRadius="4" 
                            Padding="10" 
                            Margin="0,0,5,0"
                            BorderBrush="#e2e8f0"
                            BorderThickness="1">
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="300">
                                    <Bold>Total Annotations</Bold>
                                    <LineBreak/>
                                    Total number of protein-to-GO-term annotation pairs. A single protein can have multiple GO annotations.
                                </TextBlock>
                            </ToolTip>
                        </Border.ToolTip>
                        <StackPanel>
                            <TextBlock Text="Total Annotations" 
                                       FontSize="11" 
                                       Foreground="#64748b"/>
                            <TextBlock x:Name="TotalAnnotationsText" 
                                       Text="0" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       Foreground="#f59e0b"/>
                        </StackPanel>
                    </Border>

                    <!-- GO Slim Terms -->
                    <Border Grid.Column="3" 
                            Background="White" 
                            CornerRadius="4" 
                            Padding="10"
                            BorderBrush="#e2e8f0"
                            BorderThickness="1">
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="300">
                                    <Bold>GO Slim Terms with Proteins</Bold>
                                    <LineBreak/>
                                    Number of GO Slim terms that have at least one protein annotated. This is typically less than "Total Terms" because some high-level terms may not have direct protein annotations.
                                </TextBlock>
                            </ToolTip>
                        </Border.ToolTip>
                        <StackPanel>
                            <TextBlock Text="GO Slim Terms" 
                                       FontSize="11" 
                                       Foreground="#64748b"/>
                            <TextBlock x:Name="GoSlimTermsText" 
                                       Text="0" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       Foreground="#8b5cf6"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- GO Tree View -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: GO Term Tree -->
            <Border Grid.Column="0" 
                    BorderBrush="#cbd5e1" 
                    BorderThickness="0,0,1,0"
                    Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="GO Term Hierarchy" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Margin="5,5,5,10"/>
                    <TreeView x:Name="GoTreeView"
                              SelectedItemChanged="GoTreeView_SelectedItemChanged"
                              BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="False"/>
                                <Setter Property="Padding" Value="3"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch"
                          Background="#e2e8f0"/>

            <!-- Right: Term Details -->
            <ScrollViewer Grid.Column="2" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="15">
                <StackPanel x:Name="GoTermDetailsPanel">
                    <TextBlock Text="Select a GO term to view details" 
                               FontSize="13" 
                               Foreground="#64748b"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,50,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>