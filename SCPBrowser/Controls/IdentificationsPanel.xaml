<!--
IdentificationsPanel.xaml
Identifications per run as a box plot, grouped by plate or by biological condition, with the metric switch.
Hosted by the Plate Data and Conditions tabs of the Project Browser.
Location: SCPBrowser/Controls/IdentificationsPanel.xaml
-->
<UserControl x:Class="SCPBrowser.IdentificationsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SCPBrowser"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="600">
    <UserControl.Resources>
        <!-- Two-segment switch: the checked segment is a white pill on a light grey track. -->
        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="White"/>
                                <Setter TargetName="Segment" Property="BorderBrush" Value="#d9dde3"/>
                                <Setter Property="Foreground" Value="#0f172a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Centred and only as wide as the plot needs, so a project with two plates gets a figure, not a banner. -->
        <Grid Grid.Row="0" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="2,0,2,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="PlateColorsCheckBox"
                              Content="Plate colors"
                              IsChecked="True"
                              Style="{StaticResource OptionCheckBox}"
                              ToolTip="Color each run by its plate, so a plate effect inside a condition shows. Off: each condition in its Explorer color"
                              Checked="PlotOption_Changed"
                              Unchecked="PlotOption_Changed"/>
                    <CheckBox x:Name="SplitByPlateCheckBox"
                              Content="Split by plate"
                              Style="{StaticResource OptionCheckBox}"
                              ToolTip="One box per plate inside each condition, so a plate effect within a condition shows as a shift between neighbouring boxes"
                              Checked="PlotOption_Changed"
                              Unchecked="PlotOption_Changed"/>
                    <Border x:Name="MetricSwitch"
                            Background="#eef0f3"
                            CornerRadius="7"
                            Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ProteinsRadio"
                                         Content="Protein groups"
                                         IsChecked="True"
                                         Style="{StaticResource SegmentStyle}"
                                         Checked="MetricRadio_Checked"/>
                            <RadioButton x:Name="PeptidesRadio"
                                         Content="Peptides"
                                         Style="{StaticResource SegmentStyle}"
                                         Checked="MetricRadio_Checked"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="Identifications per run"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1e293b"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
            </DockPanel>

            <local:IdentificationBoxPlot x:Name="Plot" Grid.Row="1">
                <local:IdentificationBoxPlot.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy image" Click="CopyImage_Click"/>
                        <MenuItem Header="Export PNG (300 DPI)..." Tag="300" Click="ExportPng_Click"/>
                        <MenuItem Header="Export PNG (600 DPI)..." Tag="600" Click="ExportPng_Click"/>
                        <Separator/>
                        <MenuItem Header="Copy values (tab-separated)" Click="CopyValues_Click"/>
                    </ContextMenu>
                </local:IdentificationBoxPlot.ContextMenu>
            </local:IdentificationBoxPlot>
        </Grid>

        <!-- The notes use the pane's full width, so they take one line under a narrow plot instead of three. -->
        <TextBlock x:Name="CaptionText"
                   Grid.Row="1"
                   FontSize="10.5"
                   Foreground="#94a3b8"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,6,0,0"/>
    </Grid>
</UserControl>
