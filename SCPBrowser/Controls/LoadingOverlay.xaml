<UserControl x:Class="SCPBrowser.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#CC000000"
             Visibility="Collapsed">

    <Grid>
        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Width="600">

            <!-- Animated Logo -->
            <Viewbox Width="200" Height="200" Margin="0,0,0,30">
                <Grid>
                    <!-- Outer rotating ring -->
                    <Ellipse x:Name="OuterRing"
                             Width="180" 
                             Height="180"
                             Stroke="#2563eb"
                             StrokeThickness="4"
                             StrokeDashArray="20 10"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="OuterRotation" Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Inner rotating ring (opposite direction) -->
                    <Ellipse x:Name="InnerRing"
                             Width="140" 
                             Height="140"
                             Stroke="#10b981"
                             StrokeThickness="3"
                             StrokeDashArray="15 8"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="InnerRotation" Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Pulsing logo -->
                    <Image x:Name="LogoImage"
                           Source="/images/logo.png"
                           Width="120"
                           Height="120"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
                        </Image.RenderTransform>
                    </Image>
                </Grid>
            </Viewbox>

            <!-- Main Message -->
            <TextBlock x:Name="MainMessage"
                      Text="Loading..."
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="550"
                       Margin="0,0,0,15"/>

            <!-- Secondary Progress Message -->
            <TextBlock x:Name="ProgressMessage"
                       Text=""
                       FontSize="14"
                       Foreground="#94a3b8"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="550"
                       Margin="0,0,0,20"/>

            <!-- Animated dots -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="#2563eb" Margin="0,0,8,0"/>
                <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#2563eb" Margin="0,0,8,0"/>
                <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="#2563eb"/>
            </StackPanel>

            <!-- Rotating hint / tip while processing -->
            <Border x:Name="HintPanel"
                    Background="#1A2563EB"
                    BorderBrush="#332563EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,36,0,0"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡"
                               FontSize="16"
                               VerticalAlignment="Top"
                               Margin="0,1,12,0"/>
                    <StackPanel>
                        <TextBlock Text="TIP"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#7DA9F0"
                                   Margin="0,0,0,3"/>
                        <TextBlock x:Name="HintText"
                                   Text=""
                                   FontSize="13"
                                   Foreground="#D7E2F5"
                                   TextWrapping="Wrap"
                                   MaxWidth="500"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>