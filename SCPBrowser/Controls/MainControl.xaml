<UserControl x:Class="SCPBrowser.MainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SCPBrowser"
             xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF" xmlns:controls="clr-namespace:SCPBrowser.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900" Background="WhiteSmoke">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Protein Groups" 
               VerticalAlignment="Center"
               FontWeight="SemiBold"
               FontSize="14"
               Margin="0,0,5,0"/>
        </StackPanel>

        <StackPanel x:Name="StatusPanel" 
            Grid.Row="1" 
            Orientation="Horizontal" 
            Margin="0,15,0,10"
            Visibility="Collapsed">

            <Border Background="#faf5ff" 
            BorderBrush="#9333ea" 
            BorderThickness="1" 
            CornerRadius="4" 
            Padding="15,10"
            Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Plates" 
                       FontSize="11" 
                       Foreground="#64748b" 
                       FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalPlatesText" 
                       Text="0" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#9333ea"/>
                </StackPanel>
            </Border>

            <Border Background="#f0f9ff" 
            BorderBrush="#0284c7" 
            BorderThickness="1" 
            CornerRadius="4" 
            Padding="15,10"
            Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Runs" 
                       FontSize="11" 
                       Foreground="#64748b" 
                       FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalRunsText" 
                       Text="0" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#0284c7"/>
                </StackPanel>
            </Border>

            <Border Background="#f0fdfa" 
        BorderBrush="#0d9488" 
        BorderThickness="1" 
        CornerRadius="4" 
        Padding="15,10"
        Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Protein Groups" 
                   FontSize="11" 
                   Foreground="#64748b" 
                   FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalProteinsText" 
                   Text="0" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#0d9488"/>
                </StackPanel>
            </Border>

            <Border Background="#f0fdf4" 
            BorderBrush="#16a34a" 
            BorderThickness="1" 
            CornerRadius="4" 
            Padding="15,10">
                <StackPanel>
                    <TextBlock Text="Peptides" 
                       FontSize="11" 
                       Foreground="#64748b" 
                       FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalPeptidesText" 
                       Text="0" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#16a34a"/>
                </StackPanel>
            </Border>

            <controls:NumericUpDownControl x:Name="ProteinCutoffControl"
                                   Margin="10,0,0,0"
                                   ValueChanged="ProteinCutoffControl_ValueChanged"/>

            <controls:NumericUpDownControl x:Name="MaxProteinCutoffControl"
                                   Margin="10,0,0,0"
                                   ValueChanged="MaxProteinCutoffControl_ValueChanged"/>
        </StackPanel>

        <GroupBox Header="Protein Groups per Raw File" 
          Grid.Row="3" 
          Margin="0,10,0,0">
            <controls:ProteinHistogramControl x:Name="ProteinHistogram"/>
        </GroupBox>

        <TextBlock x:Name="StatusText" 
                   Grid.Row="4" 
                   Margin="0,10,0,0"
                   Text="Open a parquet file to view analysis"/>
    </Grid>
</UserControl>