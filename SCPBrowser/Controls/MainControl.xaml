<UserControl x:Class="SCPBrowser.MainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SCPBrowser"
             xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900" Background="WhiteSmoke">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Target Protein IDs (comma-separated):" 
               VerticalAlignment="Center"
               Margin="0,0,5,0"/>

            <TextBox x:Name="TargetProteinIdsTextBox"
             Width="300"
             VerticalAlignment="Center"
             ToolTip="Enter UniProt IDs or protein identifiers separated by commas (e.g., P00761, TRYP_PIG)"/>

            <Button x:Name="ReloadButton"
            Content="Reload"
            Click="ReloadButton_Click"
            Padding="10,5"
            Margin="5,0,0,0"
            IsEnabled="False"
            ToolTip="Reload data with new target protein identifiers"/>
        </StackPanel>

        <StackPanel x:Name="StatusPanel" 
                    Grid.Row="1" 
                    Orientation="Horizontal" 
                    Margin="0,15,0,10"
                    Visibility="Collapsed">

            <Border Background="#f0f9ff" 
                    BorderBrush="#0284c7" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="15,10"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Runs" 
                               FontSize="11" 
                               Foreground="#64748b" 
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalRunsText" 
                               Text="0" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#0284c7"/>
                </StackPanel>
            </Border>

            <Border Background="#fef3c7" 
                    BorderBrush="#d97706" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="15,10"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Protein Groups" 
                               FontSize="11" 
                               Foreground="#64748b" 
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalProteinsText" 
                               Text="0" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#d97706"/>
                </StackPanel>
            </Border>

            <Border Background="#f0fdf4" 
                    BorderBrush="#16a34a" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="15,10">
                <StackPanel>
                    <TextBlock Text="Peptides" 
                               FontSize="11" 
                               Foreground="#64748b" 
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalPeptidesText" 
                               Text="0" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#16a34a"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <GroupBox Header="Protein Groups per Raw File" 
                  Grid.Row="3" 
                  Margin="0,10,0,0">
            <scottPlot:WpfPlot x:Name="ProteinChart"/>
        </GroupBox>

        <TextBlock x:Name="StatusText" 
                   Grid.Row="4" 
                   Margin="0,10,0,0"
                   Text="Open a parquet file to view analysis"/>
    </Grid>
</UserControl>