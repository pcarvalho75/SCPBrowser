<UserControl x:Class="SCPBrowser.Controls.NumericUpDownControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="120">

    <Border x:Name="OuterBorder"
            Background="#fef3c7" 
            BorderBrush="#d97706" 
            BorderThickness="1" 
            CornerRadius="4" 
            Padding="10,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Label -->
            <TextBlock x:Name="LabelText"
                       Grid.Row="0"
                       Text="Min. Proteins G." 
                       FontSize="11" 
                       Foreground="#64748b" 
                       FontWeight="SemiBold"/>

            <!-- Value and Spinners -->
            <Grid Grid.Row="1" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Editable Value -->
                <TextBox x:Name="ValueTextBox"
                         Grid.Column="0"
                         Text="800"
                         FontSize="20" 
                         FontWeight="Bold" 
                         Foreground="#d97706"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         MinWidth="60"
                         PreviewTextInput="ValueTextBox_PreviewTextInput"
                         LostFocus="ValueTextBox_LostFocus"
                         KeyDown="ValueTextBox_KeyDown"
                         MouseWheel="ValueTextBox_MouseWheel"/>

                <!-- Spinner Buttons -->
                <StackPanel Grid.Column="1" 
                            VerticalAlignment="Center"
                            Margin="5,0,0,0">

                    <!-- Up Button -->
                    <Button x:Name="UpButton"
                            Click="UpButton_Click"
                            Width="18" 
                            Height="14"
                            Padding="0"
                            Margin="0,0,0,2"
                            Cursor="Hand"
                            ToolTip="Increase">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="UpBorder"
                                        Background="#f5e6c3"
                                        CornerRadius="2">
                                    <Path x:Name="UpArrow"
                                          Data="M 0,4 L 5,0 L 10,4"
                                          Stroke="#d97706"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="0,1,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="UpBorder" Property="Background" Value="#fcd34d"/>
                                        <Setter TargetName="UpArrow" Property="Stroke" Value="#b45309"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="UpBorder" Property="Background" Value="#f59e0b"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Down Button -->
                    <Button x:Name="DownButton"
                            Click="DownButton_Click"
                            Width="18" 
                            Height="14"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip="Decrease">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="DownBorder"
                                        Background="#f5e6c3"
                                        CornerRadius="2">
                                    <Path x:Name="DownArrow"
                                          Data="M 0,0 L 5,4 L 10,0"
                                          Stroke="#d97706"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,1"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DownBorder" Property="Background" Value="#fcd34d"/>
                                        <Setter TargetName="DownArrow" Property="Stroke" Value="#b45309"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="DownBorder" Property="Background" Value="#f59e0b"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>