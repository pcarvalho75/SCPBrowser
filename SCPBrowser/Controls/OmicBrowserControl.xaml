<!--
OmicBrowserControl.xaml
Child control for browsing transcriptomic data (cell type profiles)
Location: SCPBrowser/Controls/OmicBrowserControl.xaml
-->
<UserControl x:Class="SCPBrowser.OmicBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SCPBrowser.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="White">
    <UserControl.Resources>
        <converters:PriorWeightToGreenConverter x:Key="PriorWeightToGreenConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Transcriptomic Summary Panel with Tooltips -->
        <Border Grid.Row="0"
                Background="#f1f5f9"
                Padding="15"
                BorderBrush="#cbd5e1"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Omic Database Statistics" 
                           FontSize="15" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cell Types -->
                    <Border Grid.Column="0" 
                            Background="White" 
                            CornerRadius="4" 
                            Padding="10" 
                            Margin="0,0,5,0"
                            BorderBrush="#e2e8f0"
                            BorderThickness="1">
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="300">
                                    <Bold>Cell Types</Bold>
                                    <LineBreak/>
                                    Number of distinct cell types in the reference database. Each cell type represents an aggregated gene expression profile from multiple cells of the same type.
                                </TextBlock>
                            </ToolTip>
                        </Border.ToolTip>
                        <StackPanel>
                            <TextBlock Text="Cell Types" 
                                       FontSize="11" 
                                       Foreground="#64748b"/>
                            <TextBlock x:Name="TotalCellTypesText" 
                                       Text="0" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       Foreground="#2563eb"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Cells -->
                    <Border Grid.Column="1" 
                            Background="White" 
                            CornerRadius="4" 
                            Padding="10" 
                            Margin="0,0,5,0"
                            BorderBrush="#e2e8f0"
                            BorderThickness="1">
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="300">
                                    <Bold>Total Cells</Bold>
                                    <LineBreak/>
                                    Total number of individual cells represented across all cell types in the reference database. More cells per cell type generally means more reliable predictions.
                                </TextBlock>
                            </ToolTip>
                        </Border.ToolTip>
                        <StackPanel>
                            <TextBlock Text="Total Cells" 
                                       FontSize="11" 
                                       Foreground="#64748b"/>
                            <TextBlock x:Name="TotalCellsText" 
                                       Text="0" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       Foreground="#10b981"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Genes -->
                    <Border Grid.Column="2" 
                            Background="White" 
                            CornerRadius="4" 
                            Padding="10"
                            BorderBrush="#e2e8f0"
                            BorderThickness="1">
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="300">
                                    <Bold>Total Genes</Bold>
                                    <LineBreak/>
                                    Number of unique genes detected across all cell types in the reference database. This represents the gene coverage available for cell type prediction.
                                </TextBlock>
                            </ToolTip>
                        </Border.ToolTip>
                        <StackPanel>
                            <TextBlock Text="Total Genes" 
                                       FontSize="11" 
                                       Foreground="#64748b"/>
                            <TextBlock x:Name="TotalGenesText" 
                                       Text="0" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       Foreground="#f59e0b"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Cell Type Details -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Cell Type List -->
            <Border Grid.Column="0" 
                    BorderBrush="#cbd5e1" 
                    BorderThickness="0,0,1,0"
                    Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Cell Types" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Margin="5,5,5,10"/>
                    <ListBox x:Name="CellTypeListBox"
                             SelectionChanged="CellTypeListBox_SelectionChanged"
                             BorderThickness="0"
                             Background="Transparent"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.IsDeferredScrollingEnabled="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder"
                                        Background="{Binding PriorWeight, Converter={StaticResource PriorWeightToGreenConverter}}"
                                        BorderBrush="#e2e8f0"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,2"
                                        MinHeight="50">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Enable/Disable checkbox -->
                                        <CheckBox Grid.Column="0" Grid.RowSpan="2"
                                                  x:Name="EnabledCheckBox"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  ToolTip="Uncheck to exclude from classification"
                                                  Checked="CellTypeEnabled_Changed"
                                                  Unchecked="CellTypeEnabled_Changed"
                                                  Tag="{Binding CellType}"/>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding CellType}" 
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   FontSize="11"
                                                   Foreground="#64748b">
                                            <Run Text="{Binding CellCount, StringFormat='{}{0:N0} cells'}"/>
                                            <Run Text="·"/>
                                            <Run Text="{Binding GenesExpressed, StringFormat='{}{0:N0} genes'}"/>
                                        </TextBlock>
                                        
                                        <!-- Prior weight (display only) -->
                                        <TextBlock Grid.Column="2" Grid.RowSpan="2"
                                                   Text="{Binding PriorWeight, StringFormat='{}{0:F2}'}"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="#94a3b8"
                                                   Margin="6,0,0,0"
                                                   ToolTip="Prior weight (edit in detail panel)"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch"
                          Background="#e2e8f0"/>

            <!-- Right: Cell Type Details -->
            <ScrollViewer Grid.Column="2" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="15">
                <StackPanel x:Name="CellTypeDetailsPanel">
                    <TextBlock Text="Select a cell type to view details" 
                               FontSize="13" 
                               Foreground="#64748b"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,50,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>