<UserControl x:Class="SCPBrowser.PeptideTicControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SCPBrowser"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900" Background="WhiteSmoke">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*" MinHeight="150"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="View:" 
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"
                       FontWeight="SemiBold"/>

            <RadioButton x:Name="ViewPeptideTicRadio"
                         Content="Peptide vs TIC"
                         IsChecked="True"
                         GroupName="ViewMode"
                         Margin="0,0,15,0"
                         VerticalAlignment="Center"
                         Checked="ViewMode_Changed"/>

            <RadioButton x:Name="ViewPcaRadio"
                         Content="PCA"
                         GroupName="ViewMode"
                         Margin="0,0,30,0"
                         VerticalAlignment="Center"
                         Checked="ViewMode_Changed"/>

            <Button x:Name="ShowLoadingsButton"
                Content="Loadings"
                Click="ShowLoadingsButton_Click"
                Padding="6,2"
                Margin="0,0,15,0"
                VerticalAlignment="Center"
                IsEnabled="False"
                ToolTip="Show which proteins drive PC1 and PC2 separation"/>    

            <RadioButton x:Name="ViewUmapRadio"
             Content="UMAP"
             GroupName="ViewMode"
             Margin="0,0,30,0"
             VerticalAlignment="Center"
             Checked="ViewMode_Changed"/>

            <!-- HVP Feature Selection -->
            <CheckBox x:Name="UseHvpCheckBox"
          Content="Top HVPs:"
          VerticalAlignment="Center"
          Margin="0,0,3,0"
          IsEnabled="False"
          Checked="UseHvpCheckBox_Changed"
          Unchecked="UseHvpCheckBox_Changed"
          ToolTip="Use only highly variable proteins for dimensionality reduction"/>

            <Border x:Name="HvpCountBorder"
        Background="#f1f5f9"
        BorderBrush="#94a3b8"
        BorderThickness="1"
        CornerRadius="2"
        Padding="2,0"
        VerticalAlignment="Center"
        Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HvpCountDown" Content="−" FontSize="9" Padding="3,0" 
                Click="HvpCountDown_Click" Background="Transparent" BorderThickness="0" 
                Foreground="#64748b" Cursor="Hand" IsEnabled="False"/>
                    <TextBox x:Name="HvpCountTextBox"
                 Text="500"
                 Width="32"
                 FontSize="11"
                 Foreground="#475569"
                 Background="Transparent"
                 BorderThickness="0"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Center"
                 PreviewTextInput="HvpCountTextBox_PreviewTextInput"
                 LostFocus="HvpCountTextBox_LostFocus"
                 KeyDown="HvpCountTextBox_KeyDown"
                 IsEnabled="False"/>
                    <Button x:Name="HvpCountUp" Content="+" FontSize="9" Padding="3,0"
                Click="HvpCountUp_Click" Background="Transparent" BorderThickness="0" 
                Foreground="#64748b" Cursor="Hand" IsEnabled="False"/>
                </StackPanel>
            </Border>

            <CheckBox x:Name="LogLogCheckBox"
                      Content="Log-Log Scale"
                      IsChecked="True"
                      Margin="0,0,20,0"
                      Checked="LogLogCheckBox_Changed" VerticalAlignment="Center"
                      Unchecked="LogLogCheckBox_Changed"/>

            <TextBlock Text="Color by:" 
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"
                       FontWeight="SemiBold"/>

            <RadioButton x:Name="ColorByTrypsinRadio"
                         Content="Target Protein Ratio"
                         IsChecked="True"
                         GroupName="ColorMode"
                         Margin="0,0,15,0"
                         VerticalAlignment="Center"
                         Checked="ColorMode_Changed"/>

            <RadioButton x:Name="ColorByCellTypeRadio"
                         Content="Cell Type"
                         GroupName="ColorMode"
                         Margin="0,0,20,0"
                         VerticalAlignment="Center"
                         Checked="ColorMode_Changed"
                         IsEnabled="False"/>

            <RadioButton x:Name="ColorByBioConditionRadio"
                         Content="Biological Condition"
                         GroupName="ColorMode"
                         Margin="0,0,20,0"
                         VerticalAlignment="Center"
                         Checked="ColorMode_Changed"
                         IsEnabled="False"/>

            <Button x:Name="ClearSelectionButton"
                    Content="Clear Selection"
                    Click="ClearSelectionButton_Click"
                    Padding="10,5"
                    IsEnabled="False"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0">
                <GroupBox.Header>
                    <TextBlock x:Name="PlotGroupBoxHeader" 
                       Text="Peptides vs Total Ion Current per Raw File"
                       FontWeight="SemiBold"/>
                </GroupBox.Header>
                <local:ScatterPlotControl x:Name="ScatterPlot"/>
            </GroupBox>

            <!-- Biological Condition Checkboxes Panel -->
            <Border x:Name="BioConditionPanel"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    Background="#f8fafc"
                    BorderBrush="#e2e8f0"
                    BorderThickness="1"
                    Margin="5,0,0,0"
                    Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxWidth="180">
                    <StackPanel>
                        <TextBlock Text="Biological Conditions"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Margin="0,0,0,8"/>
                        <StackPanel x:Name="BioConditionCheckboxes"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" 
                      Height="5" 
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#e2e8f0"/>

        <TabControl Grid.Row="3" Margin="0,5,0,0">
            <TabItem Header="Selected Points">
                <local:SelectedPointsGridControl x:Name="SelectedPointsGridPanel"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>