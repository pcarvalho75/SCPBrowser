<UserControl x:Class="SCPBrowser.PeptideTicControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SCPBrowser" xmlns:controls="clr-namespace:SCPBrowser.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900" Background="WhiteSmoke">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*" MinHeight="150"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="View:" 
           VerticalAlignment="Center"
           Margin="0,0,5,0"
           FontWeight="SemiBold"/>

            <ComboBox x:Name="ViewModeComboBox"
          Style="{StaticResource ToolbarComboBox}"
          ItemContainerStyle="{StaticResource ToolbarComboBoxItem}"
          SelectedIndex="0"
          SelectionChanged="ViewModeComboBox_SelectionChanged"
          ToolTip="Select visualization mode"
          Margin="0,0,10,0">
                <ComboBoxItem Content="Peptide vs TIC" Tag="PeptideTic"/>
                <ComboBoxItem Content="PCA" Tag="PCA"/>
                <ComboBoxItem Content="UMAP" Tag="UMAP"/>
            </ComboBox>

            <Button x:Name="ShowLoadingsButton"
        Content="Loadings"
        Click="ShowLoadingsButton_Click"
        Padding="6,2"
        Margin="0,0,15,0"
        VerticalAlignment="Center"
        IsEnabled="False"
        Visibility="Collapsed"
        ToolTip="Show which proteins drive PC1 and PC2 separation"/>

            <!-- HVP Feature Selection -->
            <CheckBox x:Name="UseHvpCheckBox"
          Content="Top HVPs:"
          VerticalAlignment="Center"
          Margin="0,0,3,0"
          IsEnabled="False"
          Checked="UseHvpCheckBox_Changed"
          Unchecked="UseHvpCheckBox_Changed"
          ToolTip="Use only highly variable proteins for dimensionality reduction"/>

            <Border x:Name="HvpCountBorder"
        Background="#f1f5f9"
        BorderBrush="#94a3b8"
        BorderThickness="1"
        CornerRadius="2"
        Padding="2,0"
        VerticalAlignment="Center"
        Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HvpCountDown" Content="−" FontSize="11" FontWeight="Bold" Padding="3,0" 
        Click="HvpCountDown_Click" Background="Transparent" BorderThickness="0" 
        Foreground="#1e293b" Cursor="Hand" IsEnabled="False"/>
                    <TextBox x:Name="HvpCountTextBox"
         Text="500"
         Width="40"
         Height="20"
         FontSize="11"
         FontWeight="SemiBold"
         Foreground="#1e293b"
         Background="White"
         BorderThickness="0"
         Padding="0"
         Margin="0"
         VerticalAlignment="Center"
         VerticalContentAlignment="Center"
         HorizontalContentAlignment="Center"
         PreviewTextInput="HvpCountTextBox_PreviewTextInput"
         LostFocus="HvpCountTextBox_LostFocus"
         KeyDown="HvpCountTextBox_KeyDown"
         IsEnabled="False"/>
                    <Button x:Name="HvpCountUp" Content="+" FontSize="11" FontWeight="Bold" Padding="3,0"
        Click="HvpCountUp_Click" Background="Transparent" BorderThickness="0" 
        Foreground="#1e293b" Cursor="Hand" IsEnabled="False"/>
                </StackPanel>
            </Border>

            <CheckBox x:Name="LogLogCheckBox"
                      Content="Log-Log Scale"
                      IsChecked="True"
                      Margin="0,0,20,0"
                      Checked="LogLogCheckBox_Changed" VerticalAlignment="Center"
                      Unchecked="LogLogCheckBox_Changed"/>

            <CheckBox x:Name="BatchCorrectionCheckBox"
          Content="Batch Correction"
          IsChecked="False"
          IsEnabled="False"
          Margin="0,0,20,0"
          VerticalAlignment="Center"
          Checked="BatchCorrectionCheckBox_Changed"
          Unchecked="BatchCorrectionCheckBox_Changed"
          ToolTip="Apply ComBat batch correction before dimensionality reduction (Johnson et al., 2007)"/>

            <TextBlock Text="Color by:" 
           VerticalAlignment="Center"
           Margin="0,0,5,0"
           FontWeight="SemiBold"/>

            <ComboBox x:Name="ColorModeComboBox"
            Style="{StaticResource ToolbarComboBox}"
            ItemContainerStyle="{StaticResource ToolbarComboBoxItem}"
            SelectedIndex="1"
            SelectionChanged="ColorModeComboBox_SelectionChanged"
            ToolTip="Select coloring mode for data points"
            Margin="0,0,15,0">
                  <ComboBoxItem Content="Target Protein Ratio" Tag="TargetRatio"/>
                  <ComboBoxItem x:Name="ColorByBioConditionItem" Content="Biological Condition" Tag="BioCondition" IsEnabled="False" IsSelected="True"/>
                  <ComboBoxItem x:Name="ColorByPlateItem" Content="Plate" Tag="Plate"/>
                  <ComboBoxItem x:Name="ColorByCellTypeItem" Content="Cell Type" Tag="CellType" IsEnabled="False"/>
            </ComboBox>
            <Button x:Name="ClearSelectionButton"
                    Content="Clear Selection"
                    Click="ClearSelectionButton_Click"
                    Padding="10,5"
                    IsEnabled="False"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0">
                <GroupBox.Header>
                    <TextBlock x:Name="PlotGroupBoxHeader" 
                       Text="Peptides vs Total Ion Current per Raw File"
                       FontWeight="SemiBold"/>
                </GroupBox.Header>
                <local:ScatterPlotControl x:Name="ScatterPlot"/>
            </GroupBox>

            <!-- Biological Condition Checkboxes Panel -->
            <!-- Legend Panel (Cell Types / Biological Conditions / Plates) -->
            <Border x:Name="BioConditionPanel"
        Grid.Column="1"
        Visibility="Collapsed"
        Background="#f8fafc"
        BorderBrush="#e2e8f0"
        BorderThickness="1"
        Margin="5,0,0,0"
        Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Dynamic Title -->
                    <TextBlock x:Name="LegendPanelTitle"
                   Grid.Row="0"
                   Text="Biological Conditions"
                   FontWeight="SemiBold"
                   FontSize="11"
                   Margin="0,0,0,8"/>

                    <!-- Checkboxes -->
                    <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      MaxWidth="180">
                        <StackPanel x:Name="BioConditionCheckboxes"/>
                    </ScrollViewer>

                    <!-- Pie Chart -->
                    <controls:PieChartControl x:Name="DistributionPieChart"
                                  Grid.Row="2"
                                  Height="100"
                                  Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" 
                      Height="5" 
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#e2e8f0"/>

        <TabControl Grid.Row="3" Margin="0,5,0,0">
            <TabItem Header="Selected Points">
                <local:SelectedPointsGridControl x:Name="SelectedPointsGridPanel"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>