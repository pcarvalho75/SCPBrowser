<!--
ProjectBrowser2.xaml
Mother control that hosts three child browser controls.
Location: SCPBrowser/Controls/ProjectBrowser2.xaml
-->
<UserControl x:Class="SCPBrowser.ProjectBrowser2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SCPBrowser"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Close button -->
        <Border Grid.Row="0" 
                Background="#2563eb" 
                Padding="15,10">
            <Grid>
                <TextBlock Text="Project Browser"
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Button Content="✕ Close" 
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        Background="#1e40af"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="15,5"
                        Cursor="Hand"
                        FontSize="14"/>
            </Grid>
        </Border>

        <!-- Main TabControl with Child Controls -->
        <TabControl Grid.Row="1" 
                    x:Name="MainTabControl"
                    Margin="0">

            <!-- GO Annotations Tab -->
            <TabItem Header="GO Annotations">
                <local:GOBrowserControl x:Name="GOBrowser"/>
            </TabItem>

            <!-- Transcriptomic Data Tab -->
            <TabItem Header="Transcriptomic Data">
                <local:OmicBrowserControl x:Name="OmicBrowser"/>
            </TabItem>

            <!-- Plate Data Tab -->
            <TabItem Header="Plate Data">
                <local:PlateBrowserControl x:Name="PlateBrowser"/>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>