<UserControl x:Class="SCPBrowser.Controls.ProteinCoverageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top: Protein selector and stats -->
        <Border Grid.Row="0" Background="White" CornerRadius="4" Margin="4,4,4,2" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Protein:" VerticalAlignment="Center" 
                           FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>

                <ComboBox Grid.Column="1" x:Name="ProteinComboBox" 
                          IsEditable="True" IsTextSearchEnabled="True"
                          SelectionChanged="ProteinComboBox_SelectionChanged"
                          KeyDown="ProteinComboBox_KeyDown"
                          FontSize="12" VerticalContentAlignment="Center"/>

                <Button Grid.Column="2" Content="Load" x:Name="LoadButton"
                        Click="LoadButton_Click" Margin="6,0,0,0"
                        Padding="12,4" FontSize="11" FontWeight="SemiBold"
                        Background="#1565C0" Foreground="White" BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Grid.Column="3" x:Name="ProteinInfoText" 
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="4" x:Name="StatsText" 
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="#1565C0" FontWeight="SemiBold" FontSize="11"/>

                <Button Grid.Column="5" Content="Copy" x:Name="CopyStatsButton"
                        Click="CopyStatsButton_Click" Margin="6,0,0,0"
                        Padding="8,2" FontSize="10" Visibility="Collapsed"
                        Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Main content: scrollable coverage views -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="4,2,4,4">
            <StackPanel x:Name="ContentPanel">

                <!-- Placeholder when no protein is loaded -->
                <TextBlock x:Name="PlaceholderText"
                           Text="Select a protein and click Load to view sequence coverage."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#94A3B8" FontSize="13" Margin="0,40,0,0"/>

                <!-- Coverage views (hidden until data loaded) -->
                <StackPanel x:Name="CoveragePanel" Visibility="Collapsed">

                    <!-- Zoom info bar -->
                    <Border Background="White" CornerRadius="4" Margin="0,0,0,4" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ZoomInfoText" Text="Full sequence" 
                                       FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Button x:Name="ResetZoomButton" Content="Reset Zoom" 
                                    Click="ResetZoomButton_Click" Margin="12,0,0,0"
                                    Padding="8,2" FontSize="10" Visibility="Collapsed"
                                    Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="  (scroll to zoom, drag to pan)" FontSize="9" 
                                       Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Rectangle Width="1" Height="14" Fill="#CBD5E1" Margin="12,0,0,0"/>
                            <Button x:Name="ExportButton" Content="Export PNG" 
                                    Click="ExportButton_Click" Margin="8,0,0,0"
                                    Padding="8,2" FontSize="10"
                                    Background="#1565C0" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="DPI:" FontSize="9" Foreground="#64748B" 
                                       VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <ComboBox x:Name="DpiComboBox" FontSize="10" Width="60" 
                                      SelectedIndex="0" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="300"/>
                                <ComboBoxItem Content="600"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Sequence Coverage Bar -->
                    <Border Background="White" CornerRadius="4" Margin="0,0,0,4" Padding="8,6">
                        <StackPanel>
                            <TextBlock Text="Sequence Coverage" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="#334155" Margin="0,0,0,4"/>
                            <Canvas x:Name="CoverageBarCanvas" Height="44" 
                                    ClipToBounds="True" Background="#F8FAFC"/>
                        </StackPanel>
                    </Border>

                    <!-- Domain Overlay (only visible when domains loaded) -->
                    <Border x:Name="DomainPanel" Background="White" CornerRadius="4" 
                            Margin="0,0,0,4" Padding="8,6" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="UniProt Features" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="#334155" Margin="0,0,6,0"/>
                                <TextBlock x:Name="DomainStatusText" FontSize="10" 
                                           Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Canvas x:Name="DomainCanvas" Height="50" Margin="0,4,0,0"
                                    ClipToBounds="True" Background="#F8FAFC"/>
                            <WrapPanel x:Name="DomainLegendPanel" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Peptide Bars -->
                    <Border Background="White" CornerRadius="4" Margin="0,0,0,4" Padding="8,6">
                        <StackPanel>
                            <TextBlock Text="Peptide Map" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="#334155" Margin="0,0,0,4"/>
                            <Canvas x:Name="PeptideBarCanvas" Height="120" 
                                    ClipToBounds="True" Background="#F8FAFC"/>
                        </StackPanel>
                    </Border>

                    <!-- Intensity Profile -->
                    <Border Background="White" CornerRadius="4" Margin="0,0,0,4" Padding="8,6">
                        <StackPanel>
                            <TextBlock Text="Intensity Profile (XIC along sequence)" FontSize="11" 
                                       FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <Canvas x:Name="IntensityCanvas" Height="116" 
                                    ClipToBounds="True" Background="#F8FAFC"/>
                        </StackPanel>
                    </Border>

                    <!-- Sequence Text -->
                    <Border Background="White" CornerRadius="4" Margin="0,0,0,4" Padding="8,6">
                        <StackPanel>
                            <TextBlock Text="Amino Acid Sequence" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBlock x:Name="SequenceTextBlock" 
                                       FontFamily="Consolas" FontSize="11" 
                                       TextWrapping="Wrap" Foreground="#334155"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading overlay -->
        <Border x:Name="LoadingBorder" Grid.RowSpan="2" Background="#80FFFFFF" 
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText" Text="Loading coverage..." 
                           FontSize="13" Foreground="#334155" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
