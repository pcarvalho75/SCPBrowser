<UserControl x:Class="SCPBrowser.Controls.ProteinDistributionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,2,4,2">
            <TextBlock Text="Bin size:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
            <TextBox x:Name="BinSizeTextBox" Text="100" Width="50" Height="22" FontSize="11"
                     VerticalContentAlignment="Center" Padding="4,2"
                     LostFocus="BinSizeTextBox_LostFocus" KeyDown="BinSizeTextBox_KeyDown"/>
            <Button Content="Reset View" Click="ResetViewButton_Click"
                    Padding="6,3" Margin="10,0,0,0" FontSize="11" Cursor="Hand"
                    ToolTip="Reset chart zoom and pan to default view"/>
        </StackPanel>

        <scottPlot:WpfPlot x:Name="DistributionChart" Grid.Row="1"/>
    </Grid>
</UserControl>
