<UserControl x:Class="SCPBrowser.Controls.ProteinHistogramControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,2,4,2">
            <ToggleButton x:Name="LineChartToggle"
                          Click="LineChartToggle_Click"
                          Padding="6,3"
                          FontSize="11"
                          Cursor="Hand"
                          ToolTip="Toggle between bar chart and line chart (per plate)"
                          Content="Line Chart"
                          Visibility="Collapsed"/>
            <Button x:Name="ResetViewButton"
                    Click="ResetViewButton_Click"
                    Padding="6,3"
                    Margin="6,0,0,0"
                    FontSize="11"
                    Cursor="Hand"
                    ToolTip="Reset chart zoom and pan to default view"
                    Content="Reset View"/>
            <Button x:Name="ClearExclusionsButton"
                    Click="ClearExclusionsButton_Click"
                    Padding="6,3"
                    Margin="6,0,0,0"
                    FontSize="11"
                    Cursor="Hand"
                    ToolTip="Restore all manually excluded runs"
                    Content="Clear Exclusions"
                    Visibility="Collapsed"/>
        </StackPanel>

        <scottPlot:WpfPlot x:Name="ProteinChart" Grid.Row="1"/>
    </Grid>
</UserControl>
