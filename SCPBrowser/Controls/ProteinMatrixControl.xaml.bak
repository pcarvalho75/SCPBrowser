<UserControl x:Class="SCPBrowser.ProteinMatrixControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Search Protein:" 
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <TextBox x:Name="SearchTextBox"
                     Width="250"
                     VerticalAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"
                     ToolTip="Filter proteins by name or identifier"/>

            <Button x:Name="ClearSearchButton"
                    Content="Clear"
                    Click="ClearSearchButton_Click"
                    Padding="10,5"
                    Margin="5,0,0,0"/>

            <Rectangle Width="1" Fill="#cbd5e1" Margin="15,2,15,2"/>

            <Button x:Name="ApplyContaminantsButton"
                    Content="Apply Contaminants"
                    Click="ApplyContaminantsButton_Click"
                    Padding="10,5"
                    Margin="0,0,0,0"
                    ToolTip="Recalculate contaminant ratios based on marked proteins"/>

            <Rectangle Width="1" Fill="#cbd5e1" Margin="15,2,15,2"/>

            <Button x:Name="ExportButton"
                    Content="Export to CSV"
                    Click="ExportButton_Click"
                    Padding="10,5"
                    Margin="0,0,0,0"
                    IsEnabled="False"/>
        </StackPanel>

        <DataGrid x:Name="ProteinMatrixGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserResizeRows="False"
                  CanUserSortColumns="True"
                  GridLinesVisibility="All"
                  HeadersVisibility="All"
                  SelectionMode="Extended"
                  SelectionUnit="Cell"
                  AlternatingRowBackground="#f9fafb"
                  RowBackground="White"
                  LoadingRow="ProteinMatrixGrid_LoadingRow"
                  AutoGeneratingColumn="ProteinMatrixGrid_AutoGeneratingColumn"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  ScrollViewer.IsDeferredScrollingEnabled="True"
                  ScrollViewer.CanContentScroll="True"
                  CellEditEnding="ProteinMatrixGrid_CellEditEnding">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MarkContaminantMenuItem" Header="Mark as Contaminant" Click="MarkAsContaminant_Click"/>
                    <MenuItem x:Name="UnmarkContaminantMenuItem" Header="Unmark as Contaminant" Click="UnmarkAsContaminant_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#e2e8f0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="BorderBrush" Value="#e2e8f0"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>

        <TextBlock x:Name="StatusText" 
                   Grid.Row="2" 
                   Margin="0,10,0,0"
                   Text="Load data to view protein quantification matrix"/>
    </Grid>
</UserControl>