<UserControl x:Class="SCPBrowser.SelectedPointsGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Selection Rule Header -->
        <Border Grid.Row="0" 
                Background="#f0f9ff" 
                BorderBrush="#bae6fd" 
                BorderThickness="1" 
                Padding="10,8"
                Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SelectionRuleText" 
                           Grid.Column="0"
                           Text="📋 All runs included (no filter)"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <Button x:Name="ClearExclusionsButton"
                        Grid.Column="1"
                        Content="Clear Exclusions"
                        Click="ClearExclusionsButton_Click"
                        Padding="10,5"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        ToolTip="Remove all individual run exclusions"/>
            </Grid>
        </Border>

        <!-- Data Grid with Virtualization for smooth scrolling with 1000+ items -->
        <DataGrid x:Name="SelectedPointsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="All"
                  HeadersVisibility="All"
                  SelectionMode="Single"
                  SelectionChanged="SelectedPointsGrid_SelectionChanged"
                  LoadingRow="SelectedPointsGrid_LoadingRow"
                  AlternatingRowBackground="#e8f0fe"
                  RowBackground="White"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  ScrollViewer.IsDeferredScrollingEnabled="True"
                  ScrollViewer.CanContentScroll="True">
            <DataGrid.RowHeaderStyle>
                <Style TargetType="DataGridRowHeader">
                    <Setter Property="Width" Value="40"/>
                    <Setter Property="Background" Value="#e2e8f0"/>
                    <Setter Property="Foreground" Value="#475569"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="Padding" Value="4,0"/>
                </Style>
            </DataGrid.RowHeaderStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#e2e8f0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓" 
                                        Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="40"
                                        IsReadOnly="False"/>
                <DataGridTextColumn Header="Run Name" Binding="{Binding RunName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Condition" Binding="{Binding BiologicalCondition}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Peptides" Binding="{Binding PeptideCount, StringFormat=N0}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="TIC" Binding="{Binding TicValue, StringFormat=E2}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Proteins" Binding="{Binding ProteinCount, StringFormat=N0}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Contaminant Ratio" Binding="{Binding ContaminantRatioPercent}" Width="90" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Cell Type" Width="120" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CellType}" Foreground="{Binding CellTypeBrush}" 
                                    FontWeight="SemiBold" VerticalAlignment="Center" Padding="2,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Score" Binding="{Binding CompositeScore}" Width="70" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="SelectionStatusText" 
                   Grid.Row="2"
                   Margin="10,5,0,5"
                   Text="Click a point or drag to select multiple points."
                   FontStyle="Italic"
                   Foreground="#64748b"/>
    </Grid>
</UserControl>