<UserControl x:Class="SCPBrowser.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" 
                       Text="⚙️ Application Settings" 
                       Style="{StaticResource HeaderText}"/>

            <!-- GO Enrichment Settings Group -->
            <GroupBox Grid.Row="1" Style="{StaticResource ModernGroupBox}">
                <GroupBox.Header>
                    <TextBlock Text="GO Enrichment Analysis" 
                               Style="{StaticResource SubheaderText}"/>
                </GroupBox.Header>
                <StackPanel>
                    <!-- P-Value Cutoff -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="P-Value Cutoff:" 
                                   Style="{StaticResource LabelText}"/>
                        <xctk:DoubleUpDown Grid.Column="1" 
                                           x:Name="PValueUpDown"
                                           Minimum="0.001"
                                           Maximum="0.5"
                                           Increment="0.01"
                                           FormatString="F3"
                                           VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" 
                                   Text="Significance threshold (typically 0.05)"
                                   Style="{StaticResource HelpText}"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"/>
                    </Grid>

                    <!-- Minimum Overlap -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Minimum Overlap:" 
                                   Style="{StaticResource LabelText}"/>
                        <xctk:IntegerUpDown Grid.Column="1" 
                                            x:Name="MinOverlapUpDown"
                                            Minimum="1"
                                            Maximum="20"
                                            Increment="1"
                                            VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" 
                                   Text="Minimum proteins required (typically 2-5)"
                                   Style="{StaticResource HelpText}"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Action Buttons and Status -->
            <Grid Grid.Row="2" VerticalAlignment="Top" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="💾 Save Settings" 
                        Click="SaveSettings_Click"
                        Margin="0,0,15,0"/>

                <Button Grid.Column="1"
                        Content="↺ Reset to Defaults" 
                        Click="ResetDefaults_Click"
                        Style="{StaticResource SecondaryButton}"/>

                <Button Grid.Column="2"
                        Content="✕ Close" 
                        Click="Close_Click"
                        Style="{StaticResource SecondaryButton}"
                        Margin="15,0,0,0"/>

                <StackPanel Grid.Column="3" 
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <TextBlock x:Name="SaveStatusText"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>