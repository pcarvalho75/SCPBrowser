<!-- DeleteConditionConfirmationDialog.xaml -->
<Window x:Class="SCPBrowser.DeleteConditionConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Cascade Delete"
        Height="640" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Permanent Cascade Delete"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#991b1b"/>
            <TextBlock x:Name="ConditionLine"
                       FontSize="13"
                       Foreground="#334155"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Blast radius -->
        <Border Grid.Row="1"
                Background="#fef2f2"
                BorderBrush="#fecaca"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="The following will be permanently removed:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#991b1b"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" Margin="0,0,12,4">
                        <Run Text="Raw files:" Foreground="#7f1d1d"/>
                        <Run x:Name="RawFilesValue" Text="0" FontWeight="SemiBold" Foreground="#7f1d1d"/>
                    </TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Margin="0,0,0,4">
                        <Run Text="Plates touched:" Foreground="#7f1d1d"/>
                        <Run x:Name="PlatesValue" Text="0" FontWeight="SemiBold" Foreground="#7f1d1d"/>
                    </TextBlock>

                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" Margin="0,0,12,4">
                        <Run Text="Protein quant rows:" Foreground="#7f1d1d"/>
                        <Run x:Name="ProteinQuantValue" Text="0" FontWeight="SemiBold" Foreground="#7f1d1d"/>
                    </TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Margin="0,0,0,4">
                        <Run Text="Classifications:" Foreground="#7f1d1d"/>
                        <Run x:Name="ClassificationsValue" Text="0" FontWeight="SemiBold" Foreground="#7f1d1d"/>
                    </TextBlock>

                    <TextBlock Grid.Row="2" Grid.Column="0" FontSize="12" Margin="0,0,12,0">
                        <Run Text="Run exclusions:" Foreground="#7f1d1d"/>
                        <Run x:Name="ExclusionsValue" Text="0" FontWeight="SemiBold" Foreground="#7f1d1d"/>
                    </TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12">
                        <Run Text="Orphan imports:" Foreground="#7f1d1d"/>
                        <Run x:Name="OrphanImportsValue" Text="0" FontWeight="SemiBold" Foreground="#7f1d1d"/>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Backup info -->
        <Border Grid.Row="2"
                Background="#f0f9ff"
                BorderBrush="#bae6fd"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="A complete project backup will be created first:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#075985"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="BackupPathValue"
                           FontSize="11"
                           Foreground="#0c4a6e"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"/>
                <TextBlock x:Name="BackupSizeValue"
                           FontSize="11"
                           Foreground="#0c4a6e"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Type-to-confirm -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock x:Name="TypeToConfirmLabel"
                       FontSize="12"
                       Foreground="#334155"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="ConfirmationTextBox"
                     Padding="8,6"
                     FontSize="13"
                     BorderBrush="#cbd5e1"
                     BorderThickness="1"
                     TextChanged="ConfirmationTextBox_TextChanged"/>
        </StackPanel>

        <!-- spacer row 4 takes remaining -->

        <!-- Footer buttons -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Padding="14,7"
                    Margin="0,0,8,0"
                    Background="#e2e8f0"
                    Foreground="#334155"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CancelButton_Click"/>
            <Button x:Name="DeleteButton"
                    Content="Backup and Delete"
                    Padding="14,7"
                    Background="#dc2626"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    IsEnabled="False"
                    Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
