<Window x:Class="SCPBrowser.ImportCellenOneRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import cellenONE Run"
        Height="580"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="480"
        MinWidth="500"
        Background="#f8fafc">

    <Window.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1d4ed8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#cbd5e1"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#e2e8f0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#cbd5e1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,30,30,20">

                <!-- Header -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Import cellenONE Run"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#0f172a"/>
                    <TextBlock Text="Attach an isolation run (cells + images) to a plate that already exists"
                               FontSize="12"
                               Foreground="#64748b"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Target plate -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Target Plate:*"
                               Style="{StaticResource LabelText}"/>
                    <ComboBox Grid.Column="1"
                              x:Name="PlateComboBox"
                              Padding="8"
                              DisplayMemberPath="Display"
                              SelectionChanged="PlateComboBox_SelectionChanged"/>
                </Grid>
                <TextBlock Margin="120,0,0,15"
                           Style="{StaticResource HelpText}"
                           Text="Plates that already carry cellenONE data are marked."/>

                <!-- Run folder -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Run Folder:*"
                               Style="{StaticResource LabelText}"/>
                    <TextBox Grid.Column="1"
                             x:Name="RunFolderTextBox"
                             Padding="8"
                             IsReadOnly="True"
                             Background="#ffffff"
                             Foreground="#334155"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2"
                            Content="Browse..."
                            x:Name="BrowseButton"
                            Click="Browse_Click"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,8"
                            Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Margin="120,0,0,15"
                           Style="{StaticResource HelpText}"
                           Text="Select the cellenONE '.Run' folder containing the isolated cells (*_isolated.xls)."/>

                <!-- Run preview -->
                <Border x:Name="PreviewBorder"
                        Background="#ecfdf5"
                        BorderBrush="#a7f3d0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="14,12"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="PreviewTitleText"
                                   FontWeight="SemiBold"
                                   Foreground="#065f46"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="PreviewDetailText"
                                   Foreground="#047857"
                                   FontSize="11.5"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Warning (plate already has a run / same run re-import) -->
                <Border x:Name="WarningBorder"
                        Background="#fffbeb"
                        BorderBrush="#fcd34d"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="14,12"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="WarningTitleText"
                                   FontWeight="SemiBold"
                                   Foreground="#92400e"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="WarningDetailText"
                                   Foreground="#b45309"
                                   FontSize="11.5"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Post-import note -->
                <Border Background="#eff6ff"
                        BorderBrush="#bfdbfe"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="After importing"
                                   FontWeight="SemiBold"
                                   Foreground="#1e40af"
                                   FontSize="12.5"/>
                        <TextBlock Text="Imported cells are not yet linked to their MS runs. You will be offered the Reconcile Cells ↔ Runs step, which matches each isolated cell to its raw file."
                                   Foreground="#1d4ed8"
                                   FontSize="11.5"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,14,0,0"
                           Style="{StaticResource HelpText}"
                           Text="* Required"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="1"
                Background="#f8fafc"
                BorderBrush="#e2e8f0"
                BorderThickness="0,1,0,0"
                Padding="30,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Import"
                        x:Name="ImportButton"
                        Click="Import_Click"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="False"
                        Margin="0,0,10,0"/>
                <Button Content="Cancel"
                        Click="Cancel_Click"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
