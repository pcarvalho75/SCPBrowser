<Window x:Class="SCPBrowser.ParquetReferenceLabelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Build Proteomic Reference from Parquet" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#f8fafc">

    <Window.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0f172a"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1d4ed8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#cbd5e1"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#e2e8f0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#cbd5e1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#10b981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HighlightableDataGridRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=Tag}" Value="Filtered">
                    <Setter Property="Background" Value="#fef3c7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Build Proteomic Reference" FontSize="18" FontWeight="Bold" Foreground="#0f172a"/>
            <TextBlock Text="" x:Name="FileInfoText" Foreground="#64748b" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Cell Type Label Assignment -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="15,12"
                BorderBrush="#e2e8f0" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Cell Type:" Style="{StaticResource LabelText}" Margin="0,0,8,0"/>

                <ComboBox Grid.Column="1" x:Name="CellTypeLabelComboBox"
                          ItemsSource="{Binding CellTypeLabels}"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Height="28" FontSize="12"/>

                <Button Grid.Column="2" Content="+ New" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,4"
                        Click="NewCellType_Click"/>

                <Button Grid.Column="3" Content="➡️ Apply to Filtered"
                        Style="{StaticResource SuccessButton}"
                        Padding="12,4"
                        Click="ApplyBatchAssignment_Click"/>
            </Grid>
        </Border>

        <!-- Filter + DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="15,12"
                BorderBrush="#e2e8f0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Filter row -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Filter:" Style="{StaticResource LabelText}" Margin="0,0,8,0"/>

                    <Grid Grid.Column="1" Margin="0,0,8,0">
                        <TextBox x:Name="FilterTextBox"
                                 Height="28" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Padding="6,0"
                                 TextChanged="FilterTextBox_TextChanged"/>
                        <Button x:Name="FilterClearButton"
                                Content="✕" Visibility="Collapsed"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#94a3b8" FontSize="11"
                                Cursor="Hand" Padding="6,2"
                                Click="FilterClearButton_Click"/>
                    </Grid>

                    <TextBlock Grid.Column="2" x:Name="FilterStatusText"
                               Text="All runs shown"
                               Foreground="#64748b" FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" x:Name="RunsDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          SelectionMode="Extended"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#f1f5f9"
                          BorderBrush="#e2e8f0"
                          BorderThickness="1"
                          RowHeight="28"
                          ColumnHeaderHeight="32"
                          FontSize="11"
                          RowStyle="{StaticResource HighlightableDataGridRow}"
                          CellEditEnding="RunsDataGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Run Name" Binding="{Binding RunName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cell Type" Binding="{Binding CellTypeLabel}" Width="180"
                                            Foreground="#2563eb" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Proteins" Binding="{Binding ProteinCount, StringFormat=N0}" Width="80" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- No results overlay -->
                <Border Grid.Row="1" x:Name="NoResultsBorder" Visibility="Collapsed"
                        Background="#fefce8" CornerRadius="4" Padding="20"
                        BorderBrush="#fde68a" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="No matching runs found" FontWeight="SemiBold"
                                   Foreground="#92400e" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NoResultsHelpText" Text="Try adjusting your filter"
                                   Foreground="#a16207" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Validation summary -->
                <TextBlock Grid.Row="2" x:Name="ValidationText"
                           Text="" Foreground="#dc2626" FontSize="11"
                           Margin="0,8,0,0" TextWrapping="Wrap"/>

                <!-- Label summary -->
                <TextBlock Grid.Row="3" x:Name="LabelSummaryText"
                           Text="" Foreground="#64748b" FontSize="11"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BuildButton" Content="Build Reference" IsEnabled="False"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                    Click="Build_Click"/>
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
