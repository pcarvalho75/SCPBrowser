<Window x:Class="SCPBrowser.PcaLoadingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCA Loadings - Top Contributing Proteins"
        Height="650" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#f8fafc">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="PCA Loadings Analysis" 
                       FontSize="18" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            <TextBlock x:Name="VarianceText" 
                       Text="Variance explained: PC1 = X%, PC2 = Y%"
                       Foreground="#64748b"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Show top" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="TopNComboBox" 
                          Width="60" 
                          SelectionChanged="TopNComboBox_SelectionChanged">
                    <ComboBoxItem Content="10" IsSelected="True"/>
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="30"/>
                    <ComboBoxItem Content="50"/>
                </ComboBox>
                <TextBlock Text="proteins per component" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <TextBlock x:Name="FetchStatusText" 
                           Text="" 
                           Foreground="#64748b" 
                           FontStyle="Italic"
                           VerticalAlignment="Center" 
                           Margin="20,0,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>

        <!-- Two-column layout for PC1 and PC2 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PC1 Loadings -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#e2e8f0" 
                    BorderThickness="1" 
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="Pc1Header" 
                               Grid.Row="0"
                               Text="PC1 Loadings" 
                               FontWeight="SemiBold" 
                               FontSize="14"
                               Margin="10,10,10,5"/>

                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="10,0,10,10">
                        <ItemsControl x:Name="Pc1LoadingsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding ProteinName}" 
                                                   ToolTip="{Binding Tooltip}"
                                                   ToolTipService.InitialShowDelay="200"
                                                   ToolTipService.ShowDuration="30000"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Cursor="Hand"
                                                   MouseLeftButtonUp="ProteinName_MouseLeftButtonUp">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1e40af"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="TextDecorations" Value="Underline"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Grid.Column="1" 
                                                Height="18" 
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                Background="#f1f5f9"
                                                CornerRadius="2">
                                            <Rectangle Width="{Binding BarWidth}" 
                                                       Height="14"
                                                       Fill="{Binding BarColor}"
                                                       HorizontalAlignment="{Binding BarAlignment}"
                                                       RadiusX="2"
                                                       RadiusY="2"
                                                       Margin="2"/>
                                        </Border>

                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding LoadingText}" 
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontFamily="Consolas"
                                                   Foreground="#64748b"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- PC2 Loadings -->
            <Border Grid.Column="2" 
                    Background="White" 
                    BorderBrush="#e2e8f0" 
                    BorderThickness="1" 
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="Pc2Header" 
                               Grid.Row="0"
                               Text="PC2 Loadings" 
                               FontWeight="SemiBold" 
                               FontSize="14"
                               Margin="10,10,10,5"/>

                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="10,0,10,10">
                        <ItemsControl x:Name="Pc2LoadingsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding ProteinName}" 
                                                   ToolTip="{Binding Tooltip}"
                                                   ToolTipService.InitialShowDelay="200"
                                                   ToolTipService.ShowDuration="30000"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Cursor="Hand"
                                                   MouseLeftButtonUp="ProteinName_MouseLeftButtonUp">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1e40af"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="TextDecorations" Value="Underline"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Grid.Column="1" 
                                                Height="18" 
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                Background="#f1f5f9"
                                                CornerRadius="2">
                                            <Rectangle Width="{Binding BarWidth}" 
                                                       Height="14"
                                                       Fill="{Binding BarColor}"
                                                       HorizontalAlignment="{Binding BarAlignment}"
                                                       RadiusX="2"
                                                       RadiusY="2"
                                                       Margin="2"/>
                                        </Border>

                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding LoadingText}" 
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontFamily="Consolas"
                                                   Foreground="#64748b"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Copy to Clipboard" 
                    Click="CopyButton_Click"
                    Padding="15,8"
                    Margin="0,0,10,0"/>
            <Button Content="Close" 
                    Click="CloseButton_Click"
                    Padding="15,8"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>