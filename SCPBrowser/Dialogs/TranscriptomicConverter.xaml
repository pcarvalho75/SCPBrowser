<Window x:Class="SCPBrowser.TranscriptomicConverterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert Transcriptomic Data" 
        Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"
                   Text="Convert TSV files to SQLite database for cell type prediction reference."/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="Gene Expression Matrix:" 
                       Width="160"
                       Style="{StaticResource LabelText}"/>
            <TextBox Grid.Column="1" 
                       x:Name="ExpressionFileTextBox"
                       IsReadOnly="True"
                       Margin="5,0"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="2" 
                    Content="Browse..."
                    Click="BrowseExpression_Click"
                    VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="Cell Metadata:" 
                       Width="160"
                       Style="{StaticResource LabelText}"/>
            <TextBox Grid.Column="1" 
                       x:Name="MetadataFileTextBox"
                       IsReadOnly="True"
                       Margin="5,0"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="2" 
                    Content="Browse..."
                    Click="BrowseMetadata_Click"
                    VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="Output Database:" 
                       Width="160"
                       Style="{StaticResource LabelText}"/>
            <TextBox Grid.Column="1" 
                       x:Name="OutputDirectoryTextBox"
                       Margin="5,0"
                       TextChanged="OutputDirectory_TextChanged"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="2" 
                    Content="Browse..."
                    Click="BrowseOutput_Click"
                    VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Grid.Row="4"
                   Margin="165,0,0,10"
                   TextWrapping="Wrap"
                   Style="{StaticResource HelpText}"
                   Text="Specify the path for the SQLite database file (e.g., reference_data.db)"/>

        <StackPanel Grid.Row="6" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Convert" 
                    Click="Convert_Click"
                    IsDefault="True"
                    Margin="0,0,10,0"/>
            <Button Content="Cancel" 
                    Click="Cancel_Click"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>