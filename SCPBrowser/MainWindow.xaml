<Window x:Class="SCPBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SCPBrowser"
        xmlns:converters="clr-namespace:SCPBrowser.Converters"
        mc:Ignorable="d"
        Title="SCP Browser" Height="700" Width="950">
    <Window.Resources>
        <converters:FileNameConverter x:Key="FileNameConverter"/>
        <converters:DirectoryConverter x:Key="DirectoryConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu bar -->
            <RowDefinition Height="*"/>
            <!-- Main content area -->
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." Click="NewProject_Click"/>
                <MenuItem Header="_Open Project..." Click="OpenProject_Click"/>
                <MenuItem Header="_LoadParquet..." Click="LoadParquet"/>
                <Separator/>
                <MenuItem Header="_Close Project" 
                  x:Name="CloseProjectMenuItem"
                  Click="CloseProject_Click"
                  IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Import">
                <MenuItem Header="_Parquet File..." 
                  x:Name="ImportParquetMenuItem"
                  Click="ImportParquet_Click"
                  IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="_Omic Profile (Transcriptomic)..." 
                  x:Name="ImportOmicProfileMenuItem"
                  Click="ImportOmicProfile_Click"
                  IsEnabled="False"/>
                <MenuItem Header="_GO Annotations..." 
                  x:Name="ImportGoAnnotationsMenuItem"
                  Click="CompileGoAnnotations_Click"
                  IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Utils">
                <MenuItem Header="_Settings" Click="Settings_Click"/>
                <MenuItem Header="_Project Browser" 
                  x:Name="ProjectBrowserMenuItem"
                  Click="ProjectBrowser_Click"
                  IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Main Content Area (Grid.Row="1") -->
        <Grid Grid.Row="1">
            <!-- Welcome Screen (shown when no project is open) -->
            <Border x:Name="WelcomeScreen"
                    Background="White"
                    Visibility="Visible"
                    Panel.ZIndex="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Main Welcome Content (Left Side) -->
                    <Grid Grid.Column="0" Background="#f1f5f9">
                        <Border Background="White"
            BorderBrush="#cbd5e1"
            BorderThickness="1"
            CornerRadius="12"
            Padding="40"
            Margin="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" 
                            Opacity="0.05" 
                            BlurRadius="10" 
                            ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Width="380">

                                <!-- Logo/Icon -->
                                <Border Margin="0,0,0,30" HorizontalAlignment="Center">
                                    <Image Source="images/logo.png" 
                       HorizontalAlignment="Center"  
                       VerticalAlignment="Center"/>
                                </Border>

                                <!-- Welcome Text -->
                                <TextBlock Text="Welcome to SCP Browser" 
                      FontSize="24" 
                      FontWeight="Bold"
                      Foreground="#0f172a"
                      TextAlignment="Center"
                      Margin="0,0,0,10"/>

                                <TextBlock Text="Single Cell Proteomics Analysis Platform" 
                      FontSize="13"
                      Foreground="#64748b"
                      TextAlignment="Center"
                      Margin="0,0,0,40"/>

                                <!-- Action Buttons -->
                                <Button Content="➕ Create New Project"
                   Click="NewProject_Click"
                   Height="50"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Background="#0ea5e9"
                   Foreground="White"
                   BorderThickness="0"
                   Cursor="Hand"
                   Margin="0,0,0,15">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                               CornerRadius="8"
                               Padding="20,12">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#0284c7"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="📂 Open Existing Project"
                   Click="OpenProject_Click"
                   Height="45"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Background="#f1f5f9"
                   Foreground="#334155"
                   BorderThickness="0"
                   Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                               CornerRadius="6"
                               Padding="20,12">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#e2e8f0"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Recent Projects Panel (Right Side) -->
                    <Grid Grid.Column="1" Background="#f1f5f9">
                        <Border Background="White"
            BorderBrush="#cbd5e1"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20" Margin="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" 
                            Opacity="0.05" 
                            BlurRadius="10" 
                            ShadowDepth="2"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Recent Projects Header -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                    <TextBlock Text="📌 Recent Projects" 
                          FontSize="14"
                          FontWeight="Bold"
                          Foreground="#334155"
                          Margin="0,0,0,5"/>
                                    <TextBlock Text="Quick access to your recent work" 
                          FontSize="11"
                          Foreground="#64748b"/>
                                </StackPanel>

                                <!-- Recent Projects List -->
                                <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <!-- List Container -->
                                        <ItemsControl x:Name="RecentProjectsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="RecentProject_Click"
                                       Tag="{Binding}"
                                       Margin="0,0,0,8"
                                       Padding="12,10"
                                       HorizontalContentAlignment="Stretch"
                                       Background="#f8fafc"
                                       BorderBrush="#cbd5e1"
                                       BorderThickness="1"
                                       Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                   BorderBrush="{TemplateBinding BorderBrush}"
                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                   CornerRadius="6"
                                                   Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#e0f2fe"/>
                                                                        <Setter Property="BorderBrush" Value="#0ea5e9"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}" 
                                                  FontSize="12"
                                                  FontWeight="SemiBold"
                                                  Foreground="#0f172a"
                                                  TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Converter={StaticResource DirectoryConverter}}" 
                                                  FontSize="10"
                                                  Foreground="#64748b"
                                                  TextTrimming="CharacterEllipsis"
                                                  Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- No Recent Projects Message -->
                                        <TextBlock x:Name="NoRecentProjectsText"
                              Text="No recent projects yet"
                              FontSize="11"
                              Foreground="#94a3b8"
                              FontStyle="Italic"
                              TextAlignment="Center"
                              Margin="0,40,0,0"
                              Visibility="Collapsed"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- TabControl - Main application interface (hidden initially) -->
            <TabControl x:Name="MainTabControl" 
                        SelectionChanged="MainTabControl_SelectionChanged"
                        Visibility="Collapsed"
                        Panel.ZIndex="0">
                <TabItem Header="Protein Groups">
                    <local:MainControl x:Name="MainControlTab" DataLoaded="MainControlTab_DataLoaded"/>
                </TabItem>
                <TabItem Header="Peptides vs TIC">
                    <local:PeptideTicControl x:Name="PeptideTicTab"/>
                </TabItem>
                <TabItem Header="Protein Matrix">
                    <local:ProteinMatrixControl x:Name="ProteinMatrixTab"/>
                </TabItem>
            </TabControl>

            <!-- Settings Dialog -->
            <local:SettingsControl x:Name="SettingsDialog" 
                                   Visibility="Collapsed"
                                   Panel.ZIndex="2"/>

            <!-- Project Browser Dialog - NEW VERSION -->
            <local:ProjectBrowser2 x:Name="ProjectBrowserDialog"
            Visibility="Collapsed"
            Panel.ZIndex="2"/>

            <!-- Loading Overlay -->
            <local:LoadingOverlay x:Name="LoadingOverlay" 
                                  Panel.ZIndex="3"/>
        </Grid>
    </Grid>
</Window>