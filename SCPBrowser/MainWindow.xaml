<Window x:Class="SCPBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SCPBrowser"
        xmlns:biotessera="clr-namespace:BioTessera;assembly=BioTessera"
        xmlns:converters="clr-namespace:SCPBrowser.Converters"
        mc:Ignorable="d"
        Title="SCP Browser" Height="700" Width="950">
    <Window.Resources>
        <converters:FileNameConverter x:Key="FileNameConverter"/>
        <converters:DirectoryConverter x:Key="DirectoryConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu bar -->
            <RowDefinition Height="*"/>
            <!-- Main content area -->
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem x:Name="NewProjectMenuItem" Header="_New Project..." Click="NewProject_Click"/>
                <MenuItem x:Name="OpenProjectMenuItem" Header="_Open Project..." Click="OpenProject_Click"/>
                <MenuItem Header="_LoadParquet..." Click="LoadParquet"/>
                <Separator/>
                <MenuItem Header="_Close Project" 
                  x:Name="CloseProjectMenuItem"
                  Click="CloseProject_Click"
                  IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Import">
                <MenuItem Header="_Parquet File..." 
                  x:Name="ImportParquetMenuItem"
                  Click="ImportParquet_Click"
                  IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="_Omic Profile (Transcriptomic)..." 
                  x:Name="ImportOmicProfileMenuItem"
                  Click="ImportOmicProfile_Click"
                  IsEnabled="False"/>

                
            </MenuItem>
            <MenuItem Header="_Utils">
                <MenuItem Header="_GO Database..." Click="GoDatabase_Click"/>
                <MenuItem Header="_Settings" Click="Settings_Click"/>
                <Separator/>
                <MenuItem Header="_Project Browser" 
      x:Name="ProjectBrowserMenuItem"
      Click="ProjectBrowser_Click"
      IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="_Clear Cell Type Classifications" 
      x:Name="ClearCellTypeClassificationsMenuItem"
      Click="ClearCellTypeClassifications_Click"
      IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Main Content Area (Grid.Row="1") -->
        <!-- 
Replace the "Main Content Area (Grid.Row="1")" section in MainWindow.xaml
This adds the PlateFilterControl above the TabControl
-->

        <!-- Main Content Area (Grid.Row="1") -->
        <!-- 
Replace the "Main Content Area (Grid.Row="1")" section in MainWindow.xaml
This adds the PlateFilterControl above the TabControl
-->

        <!-- Main Content Area (Grid.Row="1") -->
        <Grid Grid.Row="1">
            <!-- Define rows for PlateFilter and TabControl -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- PlateFilterControl -->
                <RowDefinition Height="*"/>
                <!-- TabControl -->
            </Grid.RowDefinitions>

            <!-- Plate Filter Control (initially hidden) -->
            <local:PlateFilterControl x:Name="PlateFilterControl"
                              Grid.Row="0"
                              Visibility="Collapsed"/>

            <!-- TabControl - Main application interface (initially hidden) -->
            <TabControl x:Name="MainTabControl" 
                Grid.Row="1"
                SelectionChanged="MainTabControl_SelectionChanged"
                Visibility="Collapsed">
                <TabItem Header="Protein Groups">
                    <local:MainControl x:Name="MainControlTab" DataLoaded="MainControlTab_DataLoaded"/>
                </TabItem>
                <TabItem Header="Peptides vs TIC">
                    <local:PeptideTicControl x:Name="PeptideTicTab"/>
                </TabItem>
                <TabItem Header="Protein Matrix">
                    <local:ProteinMatrixControl x:Name="ProteinMatrixTab"/>
                </TabItem>
                <TabItem Header="BioTessera">
                    <biotessera:ProteoMappingControl x:Name="BioTesseraTab"/>
                </TabItem>
            </TabControl>

            <!-- OVERLAYS - These span all rows with ZIndex for layering -->

            <!-- Welcome Screen (shown when no project is open) -->
            <Border x:Name="WelcomeScreen"
            Grid.RowSpan="2"
            Background="White"
            Visibility="Visible"
            Panel.ZIndex="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Main Welcome Content (Left Side) -->
                    <Grid Grid.Column="0" Background="#f1f5f9">
                        <Border Background="White"
                        BorderBrush="#cbd5e1"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="40"
                        Margin="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" 
                                          Opacity="0.05" 
                                          BlurRadius="10" 
                                          ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                Width="380">

                                <!-- Logo/Icon -->
                                <Border Margin="0,0,0,30" HorizontalAlignment="Center">
                                    <Image Source="images/logo.png" 
                                   HorizontalAlignment="Center"  
                                   VerticalAlignment="Center"/>
                                </Border>

                                <!-- Welcome Text -->
                                <TextBlock Text="Welcome to SCP Browser" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"
                                   Foreground="#0f172a"/>

                                <TextBlock Text="Single Cell Proteomics Analysis Tool" 
   FontSize="14" 
   HorizontalAlignment="Center"
   Foreground="#64748b"
   Margin="0,0,0,30"/>

                                <!-- GO Database Status Panel -->
                                <Border x:Name="GoStatusPanel"
        Background="#10DC2626"
        BorderBrush="#DC2626"
        BorderThickness="1"
        CornerRadius="8"
        Padding="16,12"
        Margin="0,0,0,20"
        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="GoStatusTitle"
                   Text="⚠️ Gene Ontology database required"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#DC2626"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="GoStatusMessage"
                   Text="Set up GO database to enable analysis"
                   FontSize="12"
                   Foreground="#B91C1C"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>
                                        <Button Content="Configure GO Database"
                Click="ConfigureGoDatabase_Click"
                HorizontalAlignment="Center"
                Padding="16,6"
                FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons -->
                                <Button x:Name="OpenProjectButton"
        Content="📁 Open Project"
        Click="OpenProject_Click"
        Style="{StaticResource ModernButton}"
        Margin="0,0,0,10"/>

                                <Button x:Name="NewProjectButton"
        Content="✨ New Project"
        Click="NewProject_Click"
        Style="{StaticResource ModernButton}"
        Margin="0,0,0,30"/>

                                <!-- Info Text -->
                                <TextBlock TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="#64748b"
                                   TextAlignment="Center"
                                   Margin="0,0,0,0">
                            <Run Text="Get started by creating a new project or opening an existing one."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Recent Projects Sidebar (Right Side) -->
                    <Border Grid.Column="1" 
                    Background="#f8fafc"
                    BorderBrush="#cbd5e1"
                    BorderThickness="1,0,0,0"
                    Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <TextBlock Grid.Row="0"
                               Text="Recent Projects"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,15"/>

                            <!-- Recent Projects List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl x:Name="RecentProjectsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="RecentProject_Click"
                                                Tag="{Binding}"
                                                Margin="0,0,0,8"
                                                HorizontalContentAlignment="Left"
                                                Background="White"
                                                BorderBrush="#cbd5e1"
                                                BorderThickness="1"
                                                Padding="12"
                                                Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Grid.Row="0"
                                                                       Text="{Binding Converter={StaticResource FileNameConverter}}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       Foreground="#0f172a"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Grid.Row="1"
                                                                       Text="{Binding Converter={StaticResource DirectoryConverter}}"
                                                                       FontSize="10"
                                                                       Foreground="#94a3b8"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,3,0,0"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#f1f5f9"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- No Recent Projects Message -->
                                    <TextBlock x:Name="NoRecentProjectsText"
                                       Text="No recent projects yet"
                                       FontSize="11"
                                       Foreground="#94a3b8"
                                       FontStyle="Italic"
                                       TextAlignment="Center"
                                       Margin="0,40,0,0"
                                       Visibility="Collapsed"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Settings Dialog -->
            <local:SettingsControl x:Name="SettingsDialog" 
                           Grid.RowSpan="2"
                           Visibility="Collapsed"
                           Panel.ZIndex="2"/>

            <!-- Project Browser Dialog - NEW VERSION -->
            <local:ProjectBrowser2 x:Name="ProjectBrowserDialog"
                           Grid.RowSpan="2"
                           Visibility="Collapsed"
                           Panel.ZIndex="2"/>

            <!-- Loading Overlay -->
            <local:LoadingOverlay x:Name="LoadingOverlay" 
                          Grid.RowSpan="2"
                          Panel.ZIndex="3"/>
        </Grid>
    </Grid>
</Window>