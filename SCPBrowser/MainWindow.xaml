<Window x:Class="SCPBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SCPBrowser"
        mc:Ignorable="d"
        Title="SCP Browser" Height="650" Width="950">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu bar -->
            <RowDefinition Height="*"/>
            <!-- Main content area -->
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open DIA-NN Parquet File..." Click="OpenDiannFile_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Convert Transcriptomic TSV to SQLite..." Click="ConvertTranscriptomicData_Click"/>
                <MenuItem Header="_Compile GO Annotations..." Click="CompileGoAnnotations_Click"/>
            </MenuItem>
            <MenuItem Header="_Utils">
                <MenuItem Header="_Settings" Click="Settings_Click"/>
                <MenuItem Header="_DB Browser" Click="DBBrowser_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Main Content Area (Grid.Row="1") - Everything switches here -->
        <Grid Grid.Row="1">
            <!-- TabControl - Main application interface -->
            <TabControl x:Name="MainTabControl" 
                        SelectionChanged="MainTabControl_SelectionChanged"
                        Panel.ZIndex="0">
                <TabItem Header="Protein Groups">
                    <local:MainControl x:Name="MainControlTab" DataLoaded="MainControlTab_DataLoaded"/>
                </TabItem>
                <TabItem Header="Peptides vs TIC">
                    <local:PeptideTicControl x:Name="PeptideTicTab"/>
                </TabItem>
                <TabItem Header="Protein Matrix">
                    <local:ProteinMatrixControl x:Name="ProteinMatrixTab"/>
                </TabItem>
                <TabItem Header="Settings">
                    <local:SettingsControl x:Name="SettingsTab"/>
                </TabItem>
            </TabControl>

            <!-- Logo overlay - shown initially -->
            <Border x:Name="LogoOverlay"
                    Background="White"
                    Panel.ZIndex="1000">
                <Image Source="/Images/logo.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="600"
                       MaxHeight="600"/>
            </Border>

            <!-- DB Browser overlay - shown when Utils > DB Browser is clicked -->
            <Border x:Name="DBBrowserOverlay"
                    Background="White"
                    Panel.ZIndex="1500"
                    Visibility="Collapsed">
                <local:DBBrowserControl x:Name="DBBrowser"/>
            </Border>

            <!-- Loading overlay - shown during operations -->
            <local:LoadingOverlay x:Name="LoadingOverlay"
                                  Visibility="Collapsed"
                                  Panel.ZIndex="2000"/>
        </Grid>
    </Grid>
</Window>