<UserControl x:Class="SCPBrowser.PeptideTicControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SCPBrowser"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900" Background="WhiteSmoke">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*" MinHeight="150"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <CheckBox x:Name="LogLogCheckBox"
                      Content="Log-Log Scale"
                      IsChecked="True"
                      Margin="0,0,20,0"
                      Checked="LogLogCheckBox_Changed"
                      Unchecked="LogLogCheckBox_Changed"/>

            <TextBlock Text="Color by:" 
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"
                       FontWeight="SemiBold"/>

            <RadioButton x:Name="ColorByTrypsinRadio"
                         Content="Target Protein Ratio"
                         IsChecked="True"
                         GroupName="ColorMode"
                         Margin="0,0,15,0"
                         VerticalAlignment="Center"
                         Checked="ColorMode_Changed"/>

            <RadioButton x:Name="ColorByCellTypeRadio"
                         Content="Cell Type"
                         GroupName="ColorMode"
                         Margin="0,0,20,0"
                         VerticalAlignment="Center"
                         Checked="ColorMode_Changed"
                         IsEnabled="False"/>

            <RadioButton x:Name="ColorByGoTermRadio"
                         Content="GO Term"
                         GroupName="ColorMode"
                         Margin="0,0,20,0"
                         VerticalAlignment="Center"
                         Checked="ColorMode_Changed"
                         IsEnabled="False"/>

            <Button x:Name="ClearSelectionButton"
                    Content="Clear Selection"
                    Click="ClearSelectionButton_Click"
                    Padding="10,5"
                    IsEnabled="False"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0">
                <GroupBox.Header>
                    <TextBlock x:Name="PlotGroupBoxHeader" 
                               Text="Peptides vs Total Ion Current per Raw File"
                               FontWeight="SemiBold"/>
                </GroupBox.Header>
                <local:ScatterPlotControl x:Name="ScatterPlot"/>
            </GroupBox>

            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#e2e8f0"/>

            <local:RunDetailControl x:Name="RunDetailPanel" Grid.Column="2"/>
        </Grid>

        <GridSplitter Grid.Row="2" 
                      Height="5" 
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#e2e8f0"/>

        <TabControl Grid.Row="3" Margin="0,5,0,0">
            <TabItem Header="GO Enrichment">
                <local:GoEnrichmentTabControl x:Name="GoEnrichmentTab"/>
            </TabItem>
            <TabItem Header="Selected Points">
                <local:SelectedPointsGridControl x:Name="SelectedPointsGridPanel"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>