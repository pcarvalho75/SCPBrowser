<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>images\SCPBrowser.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="images\logo.png" />  
    <None Remove="images\Logo2.png" />  
    <None Remove="images\PLV.png" /></ItemGroup>

  <ItemGroup>
    <Content Include="images\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="images\PLV.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="images\SCPBrowser.ico" />
    <!-- Built-in user guide, opened from Help ▸ User Guide (F1). Copied next to the executable so it ships
         with the build and with ClickOnce deployments. -->
    <Content Include="Help\SCPBrowserHelp.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="images\logo2.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="5.1.2" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <!-- Parquet.Net 6: columns are read through Services/ParquetColumnReader, which returns the 5.x array shapes.
         The 5.4 -> 6.1 upgrade was checked by a byte-for-byte comparison of everything the loader produces on
         SpaceProjectV3; any later major version needs the same check, because every downstream number comes through
         this path. -->
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="UMAP" Version="1.0.62830" />
    <PackageReference Include="UMAPuwotSharp" Version="3.42.3" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Voronoi\ProteoMappings\BioTessera.csproj" />
    <ProjectReference Include="..\..\Voronoi\Revigo\RevigoCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="DLLs\" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PatternTools">
      <HintPath>DLLs\PatternTools.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!--
    UMAPuwotSharp ships its native uwot.dll (x64) at the PACKAGE ROOT rather than under runtimes/win-x64/native/,
    so NuGet never copies it and the wrapper fails at first use. Ship it as content next to the executable so it is
    in the build output, in referencing projects (TransmutationLearning, HeadlessEmbed) and in the ClickOnce
    manifest. If it still cannot load on some machine, ScatterPlotControl falls back to the legacy engine.
  -->
  <ItemGroup>
    <Content Include="$(PkgUMAPuwotSharp)\uwot.dll" Condition="'$(PkgUMAPuwotSharp)' != '' And Exists('$(PkgUMAPuwotSharp)\uwot.dll')">
      <Link>uwot.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

</Project>
