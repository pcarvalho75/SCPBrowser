        /// Ensures the excluded_runs table exists (for existing databases created before this feature)
        /// </summary>
        public async Task EnsureExcludedRunsTableExistsAsync()
        {
            var connectionString = $"Data Source={_projectDbPath}";

            using (var connection = new SqliteConnection(connectionString))
            {
                await connection.OpenAsync();

                using (var command = connection.CreateCommand())
                {
                    command.CommandText = @"
                CREATE TABLE IF NOT EXISTS excluded_runs (
                    raw_file_id INTEGER PRIMARY KEY,
                    excluded_at TEXT DEFAULT CURRENT_TIMESTAMP,
                    FOREIGN KEY (raw_file_id) REFERENCES raw_files(raw_file_id)
                );
            ";
                    await command.ExecuteNonQueryAsync();
                }
            }
        }

        /// <summary>
        /// Ensures the protein_annotations table exists (for existing databases created before this feature)
        /// </summary>
        public async Task EnsureProteinAnnotationsTableExistsAsync()
        {
            var connectionString = $"Data Source={_projectDbPath}";

            using (var connection = new SqliteConnection(connectionString))
            {
                await connection.OpenAsync();

                using (var command = connection.CreateCommand())
                {
                    command.CommandText = @"
                CREATE TABLE IF NOT EXISTS protein_annotations (
                    accession TEXT PRIMARY KEY,
                    entry_name TEXT,
                    protein_name TEXT,
                    gene_name TEXT,
                    organism TEXT,
                    full_header TEXT,
                    source TEXT
                );
            ";
                    await command.ExecuteNonQueryAsync();
                }
            }
        }

        /// <summary>
        /// Ensures the cell_type_key_markers table exists (for existing databases created before this feature)
        /// </summary>
        public async Task EnsureKeyMarkersTableExistsAsync()
        {
            var connectionString = $"Data Source={_projectDbPath}";

            using (var connection = new SqliteConnection(connectionString))
            {
                await connection.OpenAsync();

                using (var command = connection.CreateCommand())
                {
                    command.CommandText = @"
                CREATE TABLE IF NOT EXISTS cell_type_key_markers (
                    cell_type TEXT NOT NULL,
                    gene_name TEXT NOT NULL,
                    added_at TEXT DEFAULT CURRENT_TIMESTAMP,
                    PRIMARY KEY (cell_type, gene_name)
                ) WITHOUT ROWID;
            ";
                    await command.ExecuteNonQueryAsync();
                }
            }
        }

        /// <summary>
        /// Saves key markers for a cell type (replaces existing markers for that cell type)
        /// </summary>
        public async Task SaveKeyMarkersAsync(string cellType, IEnumerable<string> markers)
        {
            await EnsureKeyMarkersTableExistsAsync();

            var connectionString = $"Data Source={_projectDbPath}";

            using (var connection = new SqliteConnection(connectionString))
            {
                await connection.OpenAsync();

                using (var transaction = connection.BeginTransaction())
                {
                    // Delete existing markers for this cell type
                    using (var deleteCmd = connection.CreateCommand())
                    {
                        deleteCmd.CommandText = "DELETE FROM cell_type_key_markers WHERE cell_type = @cellType";
                        deleteCmd.Parameters.AddWithValue("@cellType", cellType);
                        await deleteCmd.ExecuteNonQueryAsync();
                    }

                    // Insert new markers
                    foreach (var marker in markers)
                    {
                        using (var insertCmd = connection.CreateCommand())
                        {
                            insertCmd.CommandText = @"
                                INSERT INTO cell_type_key_markers (cell_type, gene_name, added_at)
                                VALUES (@cellType, @geneName, @addedAt)
                            ";
                            insertCmd.Parameters.AddWithValue("@cellType", cellType);
                            insertCmd.Parameters.AddWithValue("@geneName", marker);
                            insertCmd.Parameters.AddWithValue("@addedAt", DateTime.Now.ToString("o"));
                            await insertCmd.ExecuteNonQueryAsync();
                        }
                    }

                    transaction.Commit();
                }
            }
        }

        /// <summary>
        /// Loads all key markers for all cell types
        /// </summary>
        public async Task<Dictionary<string, HashSet<string>>> LoadAllKeyMarkersAsync()
        {
            await EnsureKeyMarkersTableExistsAsync();

            var result = new Dictionary<string, HashSet<string>>();
            var connectionString = $"Data Source={_projectDbPath}";

            using (var connection = new SqliteConnection(connectionString))
            {
                await connection.OpenAsync();

                using (var command = connection.CreateCommand())
                {
                    command.CommandText = "SELECT cell_type, gene_name FROM cell_type_key_markers ORDER BY cell_type, gene_name";

                    using (var reader = await command.ExecuteReaderAsync())
                    {
                        while (await reader.ReadAsync())
                        {
                            var cellType = reader.GetString(0);
                            var geneName = reader.GetString(1);

                            if (!result.ContainsKey(cellType))
                                result[cellType] = new HashSet<string>();

                            result[cellType].Add(geneName);
                        }
                    }
                }
            }

            return result;
        }

        /// <summary>
        /// Loads key markers for a specific cell type
        /// </summary>
        public async Task<HashSet<string>> LoadKeyMarkersForCellTypeAsync(string cellType)
        {
            await EnsureKeyMarkersTableExistsAsync();

            var result = new HashSet<string>();
            var connectionString = $"Data Source={_projectDbPath}";

            using (var connection = new SqliteConnection(connectionString))
            {
                await connection.OpenAsync();

                using (var command = connection.CreateCommand())
                {
                    command.CommandText = "SELECT gene_name FROM cell_type_key_markers WHERE cell_type = @cellType";
                    command.Parameters.AddWithValue("@cellType", cellType);

                    using (var reader = await command.ExecuteReaderAsync())
                    {
                        while (await reader.ReadAsync())
                        {
                            result.Add(reader.GetString(0));
                        }
                    }
                }
            }

            return result;
        }
    }
}