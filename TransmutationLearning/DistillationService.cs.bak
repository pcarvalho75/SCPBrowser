using System;
using System.Collections.Generic;
using System.Linq;

namespace TransmutationLearning
{
    /// <summary>
    /// Service for refining cell type assignments through distillation.
    /// Uses multiple signals (RNA-seq scores, expected distribution, delta confidence)
    /// to optimize cell type assignments.
    /// </summary>
    public class DistillationService
    {
        /// <summary>
        /// Run the distillation algorithm on retained cells
        /// </summary>
        /// <param name="retainedCells">Cells that passed confidence filtering</param>
        /// <param name="expectedDistribution">User-defined expected cell type distribution</param>
        /// <param name="sensitivity">0-1, higher = more aggressive reclassification</param>
        /// <param name="validLabelSet">Set of valid cell types to consider</param>
        /// <param name="protectionRank">Protect cell types ranked this high or better (0 = no protection)</param>
        /// <returns>DistilledDataset with potentially updated labels</returns>
        public DistilledDataset RunDistillation(
            List<CellClassification> retainedCells,
            ExpectedDistribution expectedDistribution,
            double sensitivity,
            HashSet<string> validLabelSet,
            int protectionRank = 2)
        {
            var result = new DistilledDataset
            {
                ExpectedDistribution = expectedDistribution,
                Sensitivity = sensitivity,
                DistillationApplied = true
            };

            // Initialize with original labels
            foreach (var cell in retainedCells)
            {
                result.DistilledCells.Add(cell);
                result.DistilledLabels[cell.Run] = cell.Labels;
            }

            // Compute expected proportions from rank ordering
            var expectedProportions = expectedDistribution.ToProportions(decayFactor: 0.6);

            // Calculate thresholds based on sensitivity
            // Higher sensitivity = lower threshold for reclassification
            double highConfidenceThreshold = 0.15 - (sensitivity * 0.10); // 0.15 -> 0.05
            double minScoreGapForReclass = 0.10 - (sensitivity * 0.08);   // 0.10 -> 0.02

            // Process each cell
            foreach (var cell in retainedCells)
            {
                var record = EvaluateCell(
                    cell,
                    expectedDistribution,
                    expectedProportions,
                    validLabelSet,
                    highConfidenceThreshold,
                    minScoreGapForReclass,
                    sensitivity,
                    protectionRank);

                result.ReclassificationHistory.Add(record);

                // Update label if reclassified
                if (record.WasReclassified)
                {
                    result.DistilledLabels[cell.Run] = record.DistilledLabel;
                }
            }

            return result;
        }

        /// <summary>
        /// Evaluate a single cell for potential reclassification
        /// </summary>
        private ReclassificationRecord EvaluateCell(
            CellClassification cell,
            ExpectedDistribution expectedDistribution,
            Dictionary<string, double> expectedProportions,
            HashSet<string> validLabelSet,
            double highConfidenceThreshold,
            double minScoreGapForReclass,
            double sensitivity,
            int protectionRank)
        {
            var record = new ReclassificationRecord
            {
                Run = cell.Run,
                OriginalLabel = cell.Labels,
                DistilledLabel = cell.Labels, // Default: keep original
                OriginalScore = cell.MaxScore,
                DistilledScore = cell.MaxScore,
                OriginalDelta = cell.DeltaNext,
                Reason = "Kept original"
            };

            // Rule 0: Protection rank - don't reclassify cells with high-priority labels
            // unless the score gap is extreme
            int originalRankInExpected = expectedDistribution.GetRank(cell.Labels);
            bool isProtected = protectionRank > 0 && originalRankInExpected <= protectionRank;

            if (isProtected && cell.DeltaNext >= 0.02) // Very minimal threshold for protected types
            {
                record.Reason = $"Protected (rank {originalRankInExpected} ≤ {protectionRank})";
                return record;
            }

            // Rule 1: High confidence cells are protected
            // If rank is 1 AND delta is high, don't reclassify
            if (cell.RankOfAssignedLabel == 1 && cell.DeltaNext >= highConfidenceThreshold)
            {
                record.Reason = $"High confidence (Δ={cell.DeltaNext:F3} ≥ {highConfidenceThreshold:F3})";
                return record;
            }

            // Rule 2: If original label not in valid set, try to reclassify
            bool originalIsInvalid = !validLabelSet.Contains(cell.Labels);

            // Get alternative labels from ranked scores
            var alternatives = cell.RankedScores
                .Where(rs => validLabelSet.Contains(rs.CellType) && rs.CellType != cell.Labels)
                .Take(3) // Consider top 3 alternatives
                .ToList();

            if (alternatives.Count == 0)
            {
                record.Reason = "No valid alternatives";
                return record;
            }

            // Score each alternative
            var scoredAlternatives = new List<(string CellType, double Score, double ReclassScore, string Reason)>();

            foreach (var alt in alternatives)
            {
                double reclassScore = ComputeReclassificationScore(
                    cell,
                    alt.CellType,
                    alt.Score,
                    expectedProportions,
                    sensitivity);

                string reason = $"Prior={GetPriorScore(alt.CellType, expectedProportions):F2}, " +
                               $"Gap={cell.MaxScore - alt.Score:F3}";

                scoredAlternatives.Add((alt.CellType, alt.Score, reclassScore, reason));
            }

            // Find best alternative
            var bestAlt = scoredAlternatives.OrderByDescending(a => a.ReclassScore).First();

            // Compute score for keeping original (if it's valid)
            double keepOriginalScore = 0;
            if (!originalIsInvalid)
            {
                keepOriginalScore = ComputeReclassificationScore(
                    cell,
                    cell.Labels,
                    cell.MaxScore,
                    expectedProportions,
                    sensitivity);
            }

            // Decision: reclassify if best alternative scores better than keeping original
            // AND the score gap between original and alternative is small enough
            double scoreGap = cell.MaxScore - bestAlt.Score;
            record.ScoreGap = scoreGap;

            bool shouldReclassify = false;
            string reclassReason = "";

            if (originalIsInvalid)
            {
                // Original is invalid - must reclassify
                shouldReclassify = true;
                reclassReason = "Original label invalid";
            }
            else if (scoreGap <= minScoreGapForReclass && bestAlt.ReclassScore > keepOriginalScore)
            {
                // Score gap is small and alternative has better alignment with prior
                shouldReclassify = true;
                reclassReason = $"Better prior alignment (gap={scoreGap:F3})";
            }
            else if (cell.RankOfAssignedLabel > 1)
            {
                // Original wasn't even the top-ranked choice
                // Consider reclassifying to the actual top choice if it's valid and expected
                var topRanked = cell.RankedScores.FirstOrDefault();
                if (topRanked.CellType != null &&
                    validLabelSet.Contains(topRanked.CellType) &&
                    topRanked.CellType != cell.Labels)
                {
                    double topPrior = GetPriorScore(topRanked.CellType, expectedProportions);
                    double origPrior = GetPriorScore(cell.Labels, expectedProportions);

                    if (topPrior > origPrior * 1.5) // Top choice is significantly more expected
                    {
                        shouldReclassify = true;
                        reclassReason = $"Top-ranked with better prior";
                        // Use top-ranked instead of best alternative
                        bestAlt = (topRanked.CellType, topRanked.Score, 0, "Top-ranked");
                    }
                }
            }

            if (shouldReclassify)
            {
                record.DistilledLabel = bestAlt.CellType;
                record.DistilledScore = bestAlt.Score;
                record.Reason = reclassReason;
            }

            return record;
        }

        /// <summary>
        /// Compute reclassification score for assigning a cell to a given label
        /// Higher score = better candidate for this label
        /// </summary>
        private double ComputeReclassificationScore(
            CellClassification cell,
            string targetLabel,
            double targetScore,
            Dictionary<string, double> expectedProportions,
            double sensitivity)
        {
            // Weight factors (sum to 1)
            double w_rnaScore = 0.4;      // RNA-seq score for target label
            double w_prior = 0.35;        // Prior expectation alignment
            double w_delta = 0.25;        // Delta confidence

            // Component 1: RNA-seq score (normalized 0-1 assuming scores are typically 0-1)
            double rnaComponent = Math.Min(targetScore, 1.0);

            // Component 2: Prior alignment (how expected is this cell type?)
            double priorComponent = GetPriorScore(targetLabel, expectedProportions);

            // Component 3: Delta confidence
            // Higher delta = more confident in original, less willing to change
            // For target that IS the original, high delta is good
            // For target that is NOT the original, high delta means we're less sure about changing
            double deltaComponent;
            if (targetLabel == cell.Labels)
            {
                // Keeping original - high delta is good
                deltaComponent = Math.Min(cell.DeltaNext / 0.2, 1.0);
            }
            else
            {
                // Changing to alternative - high delta means original was confident
                // So we penalize changing when delta is high
                deltaComponent = 1.0 - Math.Min(cell.DeltaNext / 0.2, 1.0);
            }

            // Apply sensitivity to prior weight
            // Higher sensitivity = prior matters more
            double adjustedPriorWeight = w_prior * (0.5 + sensitivity * 0.5);
            double adjustedRnaWeight = w_rnaScore * (1.5 - sensitivity * 0.5);
            double adjustedDeltaWeight = w_delta;

            // Normalize weights
            double totalWeight = adjustedPriorWeight + adjustedRnaWeight + adjustedDeltaWeight;
            adjustedPriorWeight /= totalWeight;
            adjustedRnaWeight /= totalWeight;
            adjustedDeltaWeight /= totalWeight;

            return adjustedRnaWeight * rnaComponent +
                   adjustedPriorWeight * priorComponent +
                   adjustedDeltaWeight * deltaComponent;
        }

        /// <summary>
        /// Get prior score for a cell type (0-1, higher = more expected)
        /// </summary>
        private double GetPriorScore(string cellType, Dictionary<string, double> expectedProportions)
        {
            if (expectedProportions.TryGetValue(cellType, out var proportion))
            {
                // Normalize: the most expected type gets ~1.0
                double maxProportion = expectedProportions.Values.Max();
                return proportion / maxProportion;
            }
            return 0.1; // Low default for unknown types
        }

        /// <summary>
        /// Compute rank-based distance between two distributions
        /// </summary>
        public double ComputeRankDistance(
            Dictionary<string, int> observedCounts,
            List<string> expectedRanking)
        {
            if (observedCounts.Count == 0 || expectedRanking.Count == 0)
                return 0;

            // Rank observed by count (descending)
            var observedRanking = observedCounts
                .OrderByDescending(kvp => kvp.Value)
                .Select(kvp => kvp.Key)
                .ToList();

            // Compute Spearman-like rank correlation
            double sumSquaredDiff = 0;
            int n = Math.Min(observedRanking.Count, expectedRanking.Count);

            for (int i = 0; i < n; i++)
            {
                var cellType = observedRanking[i];
                int expectedRank = expectedRanking.IndexOf(cellType);
                if (expectedRank < 0) expectedRank = expectedRanking.Count; // Not in expected = worst rank

                int observedRank = i;
                sumSquaredDiff += Math.Pow(expectedRank - observedRank, 2);
            }

            // Spearman correlation coefficient (inverted so higher = more different)
            double rho = 1 - (6 * sumSquaredDiff) / (n * (n * n - 1));
            return 1 - rho; // Distance: 0 = perfect match, 2 = completely opposite
        }

        /// <summary>
        /// Preview distillation without applying (for UI feedback)
        /// </summary>
        public (int wouldReclassify, Dictionary<string, int> newDistribution) PreviewDistillation(
            List<CellClassification> retainedCells,
            ExpectedDistribution expectedDistribution,
            double sensitivity,
            HashSet<string> validLabelSet,
            int protectionRank = 2)
        {
            var result = RunDistillation(retainedCells, expectedDistribution, sensitivity, validLabelSet, protectionRank);
            return (result.ReclassifiedCount, result.GetDistilledDistribution());
        }
    }
}
