<UserControl x:Class="TransmutationLearning.TransmutationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TransmutationLearning"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Phase 1: File Loading Section -->
        <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Parquet File -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="DIA-NN Parquet File" Style="{StaticResource StatLabel}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ParquetPathTextBox" IsReadOnly="True" VerticalContentAlignment="Center" Height="28"/>
                        <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Padding="12,0" Height="28" Click="BrowseParquet_Click"/>
                    </Grid>
                </StackPanel>
                
                <!-- Classification Metadata -->
                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock Text="Classification Metadata (SingleR output)" Style="{StaticResource StatLabel}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MetadataPathTextBox" IsReadOnly="True" VerticalContentAlignment="Center" Height="28"/>
                        <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Padding="12,0" Height="28" Click="BrowseMetadata_Click"/>
                    </Grid>
                </StackPanel>
                
                <!-- Load Button -->
                <Button x:Name="LoadButton" Grid.Column="2" Content="Load &amp; Process" 
                        Padding="20,0" Height="28" VerticalAlignment="Bottom"
                        Click="LoadData_Click" IsEnabled="False"
                        Background="#4A90D9" Foreground="White" BorderThickness="0"/>
            </Grid>
        </Border>
        
        <!-- Main Content (visible after loading) -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left: Charts and Threshold -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Summary Stats -->
                <Border Grid.Row="0" Background="#F0F7FF" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,30,0">
                            <TextBlock Text="Total Runs" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="TotalRunsText" Text="-" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,30,0">
                            <TextBlock Text="Proteins" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="TotalProteinsText" Text="-" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,30,0">
                            <TextBlock Text="Cell Types" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="CellTypesCountText" Text="-" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,30,0">
                            <TextBlock Text="Delta Range" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="DeltaRangeText" Text="-" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Histogram -->
                <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Delta.next Distribution" Style="{StaticResource SectionHeader}" Margin="10,8,0,0"/>
                        <Canvas x:Name="HistogramCanvas" Grid.Row="1" Margin="40,5,20,30" ClipToBounds="True"/>
                        <!-- X-axis label -->
                        <TextBlock Grid.Row="1" Text="Delta.next" HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                                   Margin="0,0,0,8" FontSize="10" Foreground="#666"/>
                    </Grid>
                </Border>
                
                <!-- Threshold Slider -->
                <Border Grid.Row="2" Background="#FFF9E6" CornerRadius="4" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Delta Threshold:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ThresholdValueText" Text="0.05" FontWeight="Bold" FontSize="14" 
                                       Foreground="#D97706" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <Button x:Name="OtsuButton" Content="Use Otsu's Threshold" Margin="20,0,0,0" 
                                    Padding="10,2" FontSize="11" Click="ApplyOtsu_Click"/>
                            <TextBlock x:Name="OtsuSuggestionText" Text="" FontSize="11" Foreground="#666" 
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Slider x:Name="ThresholdSlider" Grid.Row="1" Grid.Column="0"
                                Minimum="0" Maximum="0.5" Value="0.05" 
                                TickFrequency="0.01" IsSnapToTickEnabled="False"
                                ValueChanged="ThresholdSlider_ValueChanged"/>
                        
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Retained:" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RetainedCountText" Text="-" FontWeight="SemiBold" Margin="6,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Filtered:" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FilteredCountText" Text="-" FontWeight="SemiBold" Margin="6,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Retention:" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RetentionPercentText" Text="-" FontWeight="SemiBold" Foreground="#059669" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Status -->
                <TextBlock x:Name="StatusText" Grid.Row="3" Text="" Foreground="#666" FontSize="11" Margin="0,8,0,0"/>
            </Grid>
            
            <!-- Right: Pie Chart and Cell Type Table -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Pie Chart -->
                <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Cell Type Distribution" Style="{StaticResource SectionHeader}" Margin="10,8,0,0"/>
                        <Canvas x:Name="PieChartCanvas" Grid.Row="1" Margin="10,0,10,10"/>
                    </Grid>
                </Border>
                
                <!-- Cell Type Statistics Table -->
                <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Per-Cell-Type Statistics" Style="{StaticResource SectionHeader}" Margin="10,8,0,0"/>
                        <DataGrid x:Name="CellTypeStatsGrid" Grid.Row="1" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  RowHeight="24"
                                  FontSize="11"
                                  Margin="5,0,5,5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cell Type" Binding="{Binding CellType}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalCount}" Width="45"/>
                                <DataGridTextColumn Header="Kept" Binding="{Binding RetainedCount}" Width="40"/>
                                <DataGridTextColumn Header="%" Binding="{Binding RetentionPercent, StringFormat=F0}" Width="35"/>
                                <DataGridTextColumn Header="Med Δ" Binding="{Binding MedianDelta, StringFormat=F3}" Width="50"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        
        <!-- Loading indicator -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#80FFFFFF" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading..." FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
