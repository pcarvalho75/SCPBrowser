<UserControl x:Class="TransmutationLearning.TransmutationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TransmutationLearning"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Phase 1: File Loading Section -->
        <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Parquet File -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="DIA-NN Parquet File" Style="{StaticResource StatLabel}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ParquetPathTextBox" IsReadOnly="True" VerticalContentAlignment="Center" Height="28"/>
                        <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Padding="12,0" Height="28" Click="BrowseParquet_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Classification Metadata -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Classification Metadata (SingleR output)" Style="{StaticResource StatLabel}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MetadataPathTextBox" IsReadOnly="True" VerticalContentAlignment="Center" Height="28"/>
                        <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Padding="12,0" Height="28" Click="BrowseMetadata_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content TabControl (visible after loading) -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Visibility="Collapsed" SelectionChanged="MainTabControl_SelectionChanged">

            <!-- Tab 1: Confidence Filtering -->
            <TabItem Header="1. Confidence Filtering">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Valid Cell Types Panel -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header with Info Button -->
                            <Grid Grid.Row="0" Margin="10,8,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Valid Cell Types" Style="{StaticResource SectionHeader}" Margin="0"/>
                                <Button x:Name="InfoButton" Grid.Column="1" Content="?" FontWeight="Bold"
                                        Width="20" Height="20" FontSize="11" Padding="0"
                                        ToolTip="Learn about valid label filtering"
                                        Click="ShowMethodologyInfo_Click"/>
                            </Grid>

                            <!-- Select All/None Buttons -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,5">
                                <Button Content="All" Style="{StaticResource SmallButton}" Click="SelectAllValid_Click"/>
                                <Button Content="None" Style="{StaticResource SmallButton}" Click="SelectNoneValid_Click"/>
                            </StackPanel>

                            <!-- Checkbox List -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="10,0,10,10">
                                <StackPanel x:Name="ValidCellTypesPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Methodology Popup -->
                    <Popup x:Name="MethodologyPopup" PlacementTarget="{Binding ElementName=InfoButton}"
                           Placement="Right" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#4A90D9" BorderThickness="2"
                                CornerRadius="6" Padding="12" MaxWidth="400">
                            <StackPanel>
                                <TextBlock Text="Valid Label Set Methodology" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#333">
                                    <Run FontWeight="SemiBold">Purpose:</Run>
                                    <Run> This approach separates threshold determination from quality auditing. Invalid labels (e.g., decoy cell types not present in your sample) are diagnostic signals, not competing classes.</Run>
                                    <LineBreak/><LineBreak/>
                                    <Run FontWeight="SemiBold">How it works:</Run>
                                    <LineBreak/>
                                    <Run>• Threshold (Otsu) is computed ONLY on valid-labeled cells</Run>
                                    <LineBreak/>
                                    <Run>• Cells are retained if: (Label ∈ ValidSet) AND (Δ ≥ τ)</Run>
                                    <LineBreak/>
                                    <Run>• Invalid-labeled cells are always excluded (regardless of delta)</Run>
                                    <LineBreak/><LineBreak/>
                                    <Run FontWeight="SemiBold">Why this matters:</Run>
                                    <Run> A global threshold can be warped if decoy/invalid cell types attract misclassifications with different delta distributions. By excluding them from threshold computation, you get a stable, unbiased cutoff for your true cell types.</Run>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Center: Charts and Threshold -->
                    <Grid Grid.Column="1" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Summary Stats -->
                        <Border Grid.Row="0" Background="#F0F7FF" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="Total Runs" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="TotalRunsText" Text="-" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="Proteins" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="TotalProteinsText" Text="-" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="Cell Types" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="CellTypesCountText" Text="-" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="Delta Range" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="DeltaRangeText" Text="-" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Histogram -->
                        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Delta.next Distribution (Valid Labels Only)" Style="{StaticResource SectionHeader}" Margin="10,8,0,0"/>
                                <Canvas x:Name="HistogramCanvas" Grid.Row="1" Margin="40,5,20,30" ClipToBounds="True"/>
                                <TextBlock Grid.Row="1" Text="Delta.next" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                           Margin="0,0,0,8" FontSize="10" Foreground="#666"/>
                            </Grid>
                        </Border>

                        <!-- Threshold Slider -->
                        <Border Grid.Row="2" Background="#FFF9E6" CornerRadius="4" Padding="12" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Delta Threshold:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ThresholdValueText" Text="0.05" FontWeight="Bold" FontSize="14"
                                               Foreground="#D97706" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <Button x:Name="OtsuButton" Content="Use Otsu's Threshold" Margin="20,0,0,0"
                                            Padding="10,2" FontSize="11" Click="ApplyOtsu_Click"/>
                                    <TextBlock x:Name="OtsuSuggestionText" Text="" FontSize="11" Foreground="#666"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Slider x:Name="ThresholdSlider" Grid.Row="1"
                                        Minimum="0" Maximum="0.5" Value="0.05"
                                        TickFrequency="0.01" IsSnapToTickEnabled="False"
                                        ValueChanged="ThresholdSlider_ValueChanged"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Retained:" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RetainedCountText" Text="-" FontWeight="SemiBold" Margin="6,0,15,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Filtered (low Δ):" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FilteredCountText" Text="-" FontWeight="SemiBold" Margin="6,0,15,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Retention:" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RetentionPercentText" Text="-" FontWeight="SemiBold" Foreground="#059669" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Invalid Label Diagnostics Panel -->
                        <Border Grid.Row="3" Background="#FEF2F2" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="⚠️ Invalid Label Assignments" FontWeight="SemiBold" FontSize="12" Foreground="#991B1B"/>
                                    <TextBlock Text=" (excluded from training)" FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Count: " Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="InvalidCountText" Text="0" FontWeight="SemiBold" Foreground="#B91C1C"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Percent: " Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="InvalidPercentText" Text="0%" FontWeight="SemiBold" Foreground="#B91C1C"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="InvalidLabelBreakdownPanel" Grid.Column="1" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Status -->
                        <TextBlock x:Name="StatusText" Grid.Row="4" Text="" Foreground="#666" FontSize="11" Margin="0,8,0,0"/>
                    </Grid>

                    <!-- Right: Pie Chart and Cell Type Table -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Pie Chart -->
                        <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Cell Type Distribution (Retained)" Style="{StaticResource SectionHeader}" Margin="10,8,0,0"/>
                                <Canvas x:Name="PieChartCanvas" Grid.Row="1" Margin="10,0,10,10"/>
                            </Grid>
                        </Border>

                        <!-- Cell Type Statistics Table -->
                        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Per-Cell-Type Statistics (Valid Only)" Style="{StaticResource SectionHeader}" Margin="10,8,0,0"/>
                                <DataGrid x:Name="CellTypeStatsGrid" Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0"
                                          RowHeight="24"
                                          FontSize="11"
                                          Margin="5,0,5,5">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Cell Type" Binding="{Binding CellType}" Width="*"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalCount}" Width="45"/>
                                        <DataGridTextColumn Header="Kept" Binding="{Binding RetainedCount}" Width="40"/>
                                        <DataGridTextColumn Header="%" Binding="{Binding RetentionPercent, StringFormat=F0}" Width="35"/>
                                        <DataGridTextColumn Header="Med Δ" Binding="{Binding MedianDelta, StringFormat=F3}" Width="50"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Distillation (Optional Label Refinement) -->
            <TabItem x:Name="DistillationTab" Header="2. Distillation">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Main Controls and Visualizations -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Info Banner -->
                        <Border Grid.Row="0" Background="#FEF3C7" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#78350F">
                                <Run FontWeight="SemiBold">kNN Distillation</Run><Run> refines cell type assignments using proteomic neighborhood voting. Neighbor votes can be weighted by your biological expectations (Prior Influence).</Run>
                            </TextBlock>
                        </Border>

                        <!-- kNN Distillation Controls -->
                        <Border Grid.Row="1" Background="#F0FDF4" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- k Neighbors and Min Confidence -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Neighbors (k):" FontWeight="SemiBold" VerticalAlignment="Center"
                                               ToolTip="Number of nearest proteomic neighbors to consider for voting."/>
                                    <ComboBox x:Name="KNeighborsCombo" Margin="8,0,20,0" Width="60" SelectedIndex="1">
                                        <ComboBoxItem Content="5"/>
                                        <ComboBoxItem Content="10"/>
                                        <ComboBoxItem Content="15"/>
                                        <ComboBoxItem Content="20"/>
                                        <ComboBoxItem Content="30"/>
                                    </ComboBox>

                                    <TextBlock Text="Min Confidence:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="MinConfidenceCombo" Margin="8,0,20,0" Width="70" SelectedIndex="2">
                                        <ComboBoxItem Content="50%"/>
                                        <ComboBoxItem Content="55%"/>
                                        <ComboBoxItem Content="60%"/>
                                        <ComboBoxItem Content="70%"/>
                                        <ComboBoxItem Content="80%"/>
                                    </ComboBox>

                                    <TextBlock Text="Protection:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ProtectionRankCombo" Margin="8,0,0,0" Width="80" SelectedIndex="2"
                                              SelectionChanged="ProtectionRankCombo_SelectionChanged">
                                        <ComboBoxItem Content="None"/>
                                        <ComboBoxItem Content="Top 1"/>
                                        <ComboBoxItem Content="Top 2"/>
                                        <ComboBoxItem Content="Top 3"/>
                                        <ComboBoxItem Content="Top 4"/>
                                    </ComboBox>
                                    <TextBlock x:Name="ProtectionHintText" Text="" FontSize="10" Foreground="#059669" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Prior Influence -->
                                <Grid Grid.Row="1" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Prior Influence:" FontWeight="SemiBold" VerticalAlignment="Center"
                                               ToolTip="0 = pure kNN, 1 = prior dominates"/>
                                    <TextBlock x:Name="SensitivityValueText" Grid.Column="1" Text="0.50" FontWeight="Bold" FontSize="14"
                                               Foreground="#059669" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <Slider x:Name="SensitivitySlider" Grid.Column="2" Minimum="0" Maximum="1" Value="0.5" Margin="8,0,8,0"
                                            ValueChanged="SensitivitySlider_ValueChanged"/>
                                    <TextBlock x:Name="SensitivityHintText" Grid.Column="3" Text="(balanced)" FontSize="10" Foreground="#059669" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Detection Pattern -->
                                <Grid Grid.Row="2" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Detection Pattern:" FontWeight="SemiBold" VerticalAlignment="Center"
                                               ToolTip="Dark Matter metric - shared missing values indicate similar cell types"/>
                                    <TextBlock x:Name="DetectionWeightValueText" Grid.Column="1" Text="0.30" FontWeight="Bold" FontSize="14"
                                               Foreground="#7C3AED" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <Slider x:Name="DetectionPatternSlider" Grid.Column="2" Minimum="0" Maximum="0.7" Value="0.3" Margin="8,0,8,0"
                                            ValueChanged="DetectionPatternSlider_ValueChanged"/>
                                    <TextBlock x:Name="DetectionWeightHintText" Grid.Column="3" Text="(recommended)" FontSize="10" Foreground="#7C3AED" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- PPI Section -->
                                <Border Grid.Row="3" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                    <Grid x:Name="PPIStatusPanel">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="🧬 PPI:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PPIStatusText" Text="Not loaded" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PPIDetailsText" Text="" FontSize="10" Foreground="#666" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button x:Name="PPIDownloadButton" Grid.Column="2" Content="Download STRING" Padding="8,3"
                                                Click="PPIDownload_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- PPI Weight (only visible when loaded) -->
                                <Grid Grid.Row="4" x:Name="PPIWeightPanel" Visibility="Collapsed" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PPI Influence:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PPIWeightValueText" Grid.Column="1" Text="0.50" FontWeight="Bold" FontSize="14"
                                               Foreground="#059669" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <Slider x:Name="PPIWeightSlider" Grid.Column="2" Minimum="0" Maximum="1" Value="0.5" Margin="8,0,8,0"
                                            ValueChanged="PPIWeightSlider_ValueChanged"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <TextBlock x:Name="PPIWeightHintText" Text="(balanced)" FontSize="10" Foreground="#059669" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PPIMappingText" Text="" FontSize="10" Foreground="#666" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Download Progress (hidden by default) -->
                                <StackPanel x:Name="PPIDownloadProgress" Grid.Row="4" Visibility="Collapsed" Margin="0,4,0,0">
                                    <ProgressBar x:Name="PPIProgressBar" Height="6" Minimum="0" Maximum="100" Value="0"/>
                                    <TextBlock x:Name="PPIProgressText" Text="Downloading..." FontSize="10" Foreground="#666" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Side-by-side Pie Charts -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="0,0,5,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Original Distribution" Style="{StaticResource SectionHeader}" Margin="10,8,0,0"/>
                                    <Canvas x:Name="OriginalDistPieCanvas" Grid.Row="1" Margin="10,0,10,10" SizeChanged="DistillationPieCanvas_SizeChanged"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="5,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Distilled Distribution" Style="{StaticResource SectionHeader}" Margin="10,8,0,0"/>
                                    <Canvas x:Name="DistilledDistPieCanvas" Grid.Row="1" Margin="10,0,10,10" SizeChanged="DistillationPieCanvas_SizeChanged"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Run Distillation Button and Stats -->
                        <Border Grid.Row="3" Background="#F8F9FA" CornerRadius="4" Padding="10" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Reclassified:" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ReclassifiedCountText" Text="0" FontWeight="Bold" FontSize="14"
                                               Foreground="#D97706" Margin="8,0,15,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="of" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="DistillationTotalText" Text="0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ReclassifiedPercentText" Text="(0%)" FontSize="11" Foreground="#666"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="RunSmartDistillationButton" Content="▶ Smart Distillation" Padding="12,6"
                                            Background="#059669" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                            Click="RunSmartDistillation_Click"/>
                                    <Button x:Name="PreviewDistillationButton" Content="Preview" Padding="10,6" Margin="6,0,0,0"
                                            Click="PreviewDistillation_Click"/>
                                    <Button x:Name="RunDistillationButton" Content="Manual" Padding="10,6" Margin="6,0,0,0"
                                            Click="RunDistillation_Click"/>
                                    <Button x:Name="SkipDistillationButton" Content="Skip →" Padding="10,6" Margin="6,0,0,0"
                                            Click="SkipDistillation_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right: TabControl with Expected Distribution, Reclassification, Iteration History -->
                    <TabControl Grid.Column="1" TabStripPlacement="Top">
                        <!-- Expected Distribution Tab -->
                        <TabItem Header="Prior">
                            <Border Background="White">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,4">
                                        <Button Content="↑" Style="{StaticResource SmallButton}" Click="MoveExpectedUp_Click" Width="24"/>
                                        <Button Content="↓" Style="{StaticResource SmallButton}" Click="MoveExpectedDown_Click" Width="24"/>
                                        <TextBlock Text="Set weights (must sum to 1)" FontSize="10" Foreground="#666" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ListBox x:Name="ExpectedDistributionListBox" Grid.Row="1" Margin="8,0,8,8"
                                             SelectionMode="Single">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="25"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Rank}" FontWeight="Bold" Foreground="#666" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CellType}" VerticalAlignment="Center"/>
                                                    <xctk:DecimalUpDown Grid.Column="2" Value="{Binding Weight, Mode=TwoWay}"
                                                                        Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                                                        ValueChanged="PriorWeight_ValueChanged"
                                                                        Width="70" Height="22" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,8">
                                        <Button Content="Reset Weights" Style="{StaticResource SmallButton}" Click="ResetExpectedWeights_Click" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="WeightSumText" Text="Sum: 1.00" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="#059669" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                        <CheckBox x:Name="ManualWeightsCheckBox" Content="Manual" VerticalAlignment="Center"
                                                  ToolTip="When checked, weights are not auto-normalized. They will be proportionally adjusted when distilling."
                                                  Checked="ManualWeightsCheckBox_Changed" Unchecked="ManualWeightsCheckBox_Changed"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </TabItem>

                        <!-- Reclassification Details Tab -->
                        <TabItem Header="Changes">
                            <Border Background="White">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#FEF2F2" Margin="8,8,8,4" Padding="6" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="Label Transitions" FontWeight="SemiBold" FontSize="11"/>
                                            <StackPanel x:Name="TransitionSummaryPanel" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <DataGrid x:Name="ReclassificationGrid" Grid.Row="1"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              BorderThickness="0" RowHeight="20" FontSize="10" Margin="4,0,4,4">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Run" Binding="{Binding Run}" Width="100"/>
                                            <DataGridTextColumn Header="From" Binding="{Binding OriginalLabel}" Width="70"/>
                                            <DataGridTextColumn Header="To" Binding="{Binding DistilledLabel}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </TabItem>

                        <!-- Iteration History Tab -->
                        <TabItem Header="Progress">
                            <Border Background="White">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" x:Name="IterationProgressPanel" Visibility="Collapsed">
                                        <TextBlock x:Name="IterationStatusText" Text="Not started" FontWeight="SemiBold" Foreground="#047857"/>
                                        <ProgressBar x:Name="IterationProgressBar" Height="6" Margin="0,6,0,0"
                                                     Foreground="#10B981" Background="#D1FAE5"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="Iteration History" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,4"/>

                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="IterationHistoryList" FontSize="10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="35"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Iteration, StringFormat=Iter {0}}" FontWeight="SemiBold" Foreground="#065F46"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Foreground="#047857">
                                                                    <Run Text="{Binding ProteinsUsed, Mode=OneWay}"/><Run Text=" proteins → "/><Run Text="{Binding MarkersSelected, Mode=OneWay}"/><Run Text=" markers"/>
                                                                </TextBlock>
                                                                <TextBlock Foreground="#6B7280" FontStyle="Italic">
                                                                    <Run Text="{Binding ChangePercent, StringFormat={}{0:F1}%, Mode=OneWay}"/><Run Text=" changed - "/><Run Text="{Binding Notes, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <!-- Tab 3: Feature Selection -->
            <TabItem Header="3. Feature Selection">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Auto-Selected Markers Banner (shown after Smart Distillation) -->
                    <Border x:Name="AutoSelectedMarkersBanner" Grid.Row="0" Background="#DBEAFE" CornerRadius="4"
                            Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" FontWeight="Bold" Foreground="#1D4ED8" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AutoSelectedMarkersText" Text="Auto-selected 0 markers from Smart Distillation."
                                           FontWeight="SemiBold" Foreground="#1E40AF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text=" Review and adjust if needed." Foreground="#3B82F6" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="ApplyAutoMarkersButton" Grid.Column="1" Content="Apply Auto-Selected"
                                    Padding="12,6" Background="#2563EB" Foreground="White" BorderThickness="0"
                                    Click="ApplyAutoMarkers_Click"
                                    ToolTip="Select the markers that were automatically chosen by Smart Distillation"/>
                        </Grid>
                    </Border>

                    <!-- Selection Criteria Panel -->
                    <Border Grid.Row="1" Background="#F0FDF4" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0"
                                        ToolTip="Discrimination Score based on Kruskal-Wallis H test.&#x0a;&#x0a;IMPORTANT: Since cell labels are iteratively refined during&#x0a;distillation, these are NOT true p-values for hypothesis testing.&#x0a;They represent each protein's contribution to cluster separation.&#x0a;&#x0a;UNDERLYING TEST: Kruskal-Wallis H (non-parametric rank ANOVA)&#x0a;• Tests if expression ranks differ across cell types&#x0a;• Robust to non-normal distributions&#x0a;• Does NOT assume equal variances&#x0a;&#x0a;INTERPRETATION (as discrimination scores):&#x0a;• &lt; 0.001: Excellent discriminator&#x0a;• &lt; 0.01: Strong discriminator&#x0a;• &lt; 0.05: Good discriminator&#x0a;• &lt; 0.10: Moderate discriminator&#x0a;&#x0a;Use in combination with Specificity Δ for biological relevance.">
                                <TextBlock Text="Max Disc. Score" Style="{StaticResource StatLabel}"/>
                                <ComboBox x:Name="MaxPValueCombo" Width="80" SelectedIndex="3">
                                    <ComboBoxItem Content="0.001"/>
                                    <ComboBoxItem Content="0.01"/>
                                    <ComboBoxItem Content="0.05"/>
                                    <ComboBoxItem Content="0.10"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,20,0"
                                        ToolTip="Minimum detection rate in the best cell type.&#x0a;&#x0a;A protein detected in only 20% of cells may be noisy or&#x0a;unreliable. Higher thresholds (40-50%) ensure the marker&#x0a;is consistently present in its target cell type.&#x0a;&#x0a;Recommended: 30-40% for typical SCP data.">
                                <TextBlock Text="Min Detection %" Style="{StaticResource StatLabel}"/>
                                <ComboBox x:Name="MinDetectionCombo" Width="80" SelectedIndex="1">
                                    <ComboBoxItem Content="20%"/>
                                    <ComboBoxItem Content="30%"/>
                                    <ComboBoxItem Content="40%"/>
                                    <ComboBoxItem Content="50%"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,20,0"
                                        ToolTip="Minimum specificity delta (Δ) between best and second-best cell type.&#x0a;&#x0a;Higher values select proteins that are more uniquely expressed&#x0a;in one cell type vs. others. A Δ of 0.5 means the protein's&#x0a;expression in its best type is 0.5 log2 units higher than&#x0a;the next best type.&#x0a;&#x0a;Recommended: 0.50 for balanced panels, 0.75+ for high specificity.">
                                <TextBlock Text="Min Specificity Δ" Style="{StaticResource StatLabel}"/>
                                <ComboBox x:Name="MinSpecificityCombo" Width="80" SelectedIndex="1">
                                    <ComboBoxItem Content="0.25"/>
                                    <ComboBoxItem Content="0.50"/>
                                    <ComboBoxItem Content="0.75"/>
                                    <ComboBoxItem Content="1.00"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,20,0"
                                        ToolTip="Minimum fraction of cells (across all types) where the protein is detected.&#x0a;&#x0a;Filters out proteins that are only detected in a tiny subset&#x0a;of the dataset. A marker detected in only 10% of all cells&#x0a;may not generalize well.&#x0a;&#x0a;Recommended: 30% for robust panels.">
                                <TextBlock Text="Min Cell %" Style="{StaticResource StatLabel}"/>
                                <ComboBox x:Name="MinCellFractionCombo" Width="80" SelectedIndex="1">
                                    <ComboBoxItem Content="20%"/>
                                    <ComboBoxItem Content="30%"/>
                                    <ComboBoxItem Content="40%"/>
                                    <ComboBoxItem Content="50%"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="0,0,20,0" VerticalAlignment="Bottom">
                                <CheckBox x:Name="RequireRobustCheckbox" Content="Require Robustness" IsChecked="True"
                                          ToolTip="When checked, only includes proteins that pass a robustness&#x0a;check (consistent ranking across bootstrap samples).&#x0a;&#x0a;Recommended: Keep checked for reliable panels."/>
                            </StackPanel>

                            <StackPanel Grid.Column="5" Margin="0,0,20,0" VerticalAlignment="Bottom">
                                <CheckBox x:Name="FilterFromDistillationCheckbox" Content="Distillation markers only"
                                          IsChecked="False" IsEnabled="False"
                                          Checked="FilterFromDistillationCheckbox_Changed"
                                          Unchecked="FilterFromDistillationCheckbox_Changed"
                                          ToolTip="When checked, only considers the markers auto-selected&#x0a;by Smart Distillation. The filters below will only apply&#x0a;within this pre-selected set.&#x0a;&#x0a;Enable this to refine the distillation results rather than&#x0a;searching all proteins."/>
                            </StackPanel>

                            <Button x:Name="RunFeatureSelectionButton" Grid.Column="7"
                                    Content="Run Feature Selection" Padding="15,8"
                                    Background="#059669" Foreground="White" BorderThickness="0"
                                    Click="RunFeatureSelection_Click"/>
                        </Grid>
                    </Border>

                    <!-- Protein Statistics Grid -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="10,8,10,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Protein Statistics" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    <TextBlock x:Name="ProteinStatsCountText" Text="" FontSize="11" Foreground="#666"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Select All Passing" Style="{StaticResource SmallButton}" Click="SelectAllPassing_Click"/>
                                    <Button Content="Clear" Style="{StaticResource SmallButton}" Click="ClearSelection_Click"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="ProteinStatsGrid" Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      RowHeight="24"
                                      FontSize="11"
                                      Margin="5,0,5,5"
                                      CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                                    <DataGridTextColumn Header="Protein" Binding="{Binding ProteinName}" Width="120" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Best Type" Binding="{Binding BestCellType}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Detect%" Binding="{Binding BestDetectionPercent, StringFormat=F0}" Width="60" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Expr" Binding="{Binding BestCellTypeExpression, StringFormat=F2}" Width="50" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Δ Spec" Binding="{Binding SpecificityDelta, StringFormat=F2}" Width="55" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Wt.Score" Binding="{Binding WeightedSpecificityScore, StringFormat=F2}" Width="60" IsReadOnly="True">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="ToolTip" Value="Weighted Specificity Score = Delta × Detection Rate. Higher = better marker."/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Disc.Score" Binding="{Binding PValueFormatted}" Width="70" IsReadOnly="True">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="ToolTip" Value="Discrimination Score (Kruskal-Wallis derived). Lower = better discriminator. Not a true p-value due to iterative label refinement."/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Robust" Binding="{Binding RobustFlag}" Width="50" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Bottom: Selection Summary and Export -->
                    <Border Grid.Row="3" Background="#F8F9FA" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Selected Markers:" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SelectedMarkersCountText" Text="0" FontWeight="Bold" FontSize="16"
                                           Foreground="#059669" Margin="8,0,20,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Median Δ:" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MedianDeltaText" Text="-" FontWeight="SemiBold" Margin="8,0,20,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cell Types Covered:" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CellTypesCoveredText" Text="-" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ExportPrefButton" Content="Export .pref" Padding="15,8" Margin="0,0,10,0"
                                        Background="#4A90D9" Foreground="White" BorderThickness="0"
                                        Click="ExportPref_Click" IsEnabled="False"/>
                                <Button x:Name="ViewPanelReportButton" Content="View Panel Report →" Padding="15,8"
                                        Background="#7C3AED" Foreground="White" BorderThickness="0"
                                        Click="ViewPanelReport_Click" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 4: Panel Report -->
            <TabItem Header="4. Panel Report">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#EDE9FE" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="PROTEOMICS MARKER PANEL" FontSize="18" FontWeight="Bold" Foreground="#5B21B6"/>
                                <TextBlock x:Name="PanelReportSubtitle" Text="Generated from TransmutationLearning"
                                           FontSize="11" Foreground="#666"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Export PNG" Padding="10,5" Margin="0,0,8,0" Click="ExportPanelPng_Click"/>
                                <Button Content="Export PDF" Padding="10,5" Click="ExportPanelPdf_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Content: DotPlot + Side Panels -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- DotPlot Canvas -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Marker Expression DotPlot" Style="{StaticResource SectionHeader}" Margin="10,8,0,0"/>
                                <Canvas x:Name="DotPlotCanvas" Grid.Row="1" Margin="60,10,20,40" ClipToBounds="True" SizeChanged="DotPlotCanvas_SizeChanged"/>
                                <!-- Legend -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="Size: Detection %" FontSize="10" Foreground="#666" Margin="0,0,20,0"/>
                                    <TextBlock Text="Color: Expression (log2)" FontSize="10" Foreground="#666"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Right: Top Markers + Stats + Validation -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top Markers by Cell Type -->
                            <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Top Markers by Cell Type" Style="{StaticResource SectionHeader}" Margin="10,8,0,0"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,0,10,10">
                                        <StackPanel x:Name="TopMarkersPanel"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Panel Statistics -->
                            <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Panel Statistics" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Markers:" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="PanelTotalMarkersText" Grid.Row="0" Grid.Column="1" Text="-" FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Cell Types:" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="PanelCellTypesText" Grid.Row="1" Grid.Column="1" Text="-" FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Median Δ:" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="PanelMedianDeltaText" Grid.Row="2" Grid.Column="1" Text="-" FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Training Cells:" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="PanelTrainingCellsText" Grid.Row="3" Grid.Column="1" Text="-" FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Self-Consistency Validation -->
                            <Border Grid.Row="2" x:Name="ValidationPanel" CornerRadius="4" Padding="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F0F9FF"/>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Self-Consistency Check" FontWeight="SemiBold"/>
                                        <TextBlock Text=" (?)" FontSize="10" Foreground="#666" VerticalAlignment="Center"
                                                   ToolTip="Validates the classifier by re-classifying training cells using the selected markers. Agreement ≥ 80% indicates a robust classifier."/>
                                    </StackPanel>

                                    <Button x:Name="RunValidationButton" Content="Run Validation" Padding="10,5"
                                            HorizontalAlignment="Left" Click="RunValidation_Click"
                                            ToolTip="Apply the generated classifier back to training data and measure agreement"/>

                                    <!-- Validation Results (initially hidden) -->
                                    <StackPanel x:Name="ValidationResultsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Agreement:" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="ValidationAgreementText" Grid.Row="0" Grid.Column="1" Text="-" FontWeight="Bold"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="ValidationStatusText" Grid.Row="1" Grid.Column="1" Text="-" FontWeight="SemiBold"/>
                                        </Grid>

                                        <!-- Per-type accuracy (expandable) -->
                                        <Expander Header="Per-Type Accuracy" Margin="0,8,0,0" FontSize="11">
                                            <StackPanel x:Name="PerTypeAccuracyPanel" Margin="5,5,0,0"/>
                                        </Expander>
                                    </StackPanel>

                                    <!-- Warning message -->
                                    <TextBlock x:Name="ValidationWarningText" TextWrapping="Wrap" FontSize="11"
                                               Foreground="#DC2626" Margin="0,8,0,0" Visibility="Collapsed"/>

                                    <!-- Cross-Validation Section -->
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Cross-Validation (Held-Out)" FontWeight="SemiBold"/>
                                                <TextBlock Text=" (?)" FontSize="10" Foreground="#666" VerticalAlignment="Center"
                                                           ToolTip="5-fold cross-validation tests predictive power on held-out cells.&#x0a;&#x0a;Unlike self-consistency, this proves the classifier generalizes to unseen data.&#x0a;This is the recommended validation for publication."/>
                                            </StackPanel>

                                            <Button x:Name="RunCrossValidationButton" Content="Run 5-Fold CV" Padding="10,5"
                                                    HorizontalAlignment="Left" Click="RunCrossValidation_Click"
                                                    ToolTip="Run 5-fold cross-validation to measure predictive accuracy on held-out cells"/>

                                            <!-- CV Results (initially hidden) -->
                                            <StackPanel x:Name="CVResultsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mean Accuracy:" Style="{StaticResource StatLabel}"/>
                                                    <TextBlock x:Name="CVAccuracyText" Grid.Row="0" Grid.Column="1" Text="-" FontWeight="Bold"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Std Dev:" Style="{StaticResource StatLabel}"/>
                                                    <TextBlock x:Name="CVStdText" Grid.Row="1" Grid.Column="1" Text="-"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" Style="{StaticResource StatLabel}"/>
                                                    <TextBlock x:Name="CVStatusText" Grid.Row="2" Grid.Column="1" Text="-" FontWeight="SemiBold"/>
                                                </Grid>

                                                <!-- Per-fold accuracy (expandable) -->
                                                <Expander Header="Per-Fold Accuracy" Margin="0,8,0,0" FontSize="11">
                                                    <StackPanel x:Name="PerFoldAccuracyPanel" Margin="5,5,0,0"/>
                                                </Expander>
                                            </StackPanel>

                                            <!-- CV Warning message -->
                                            <TextBlock x:Name="CVWarningText" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="#DC2626" Margin="0,8,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Markers per Type Bar Chart -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0" Height="100">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Markers per Cell Type" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,0,15,0"/>
                            <Canvas x:Name="MarkersPerTypeCanvas" Grid.Column="1" ClipToBounds="True" SizeChanged="MarkersPerTypeCanvas_SizeChanged"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Loading indicator -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#80FFFFFF" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText" Text="Loading..." FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
